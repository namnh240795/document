# Database - auth_db
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres

# Database - sms_db
SMS_DB_HOST=localhost
SMS_DB_PORT=5433
SMS_DB_NAME=sms_db
SMS_DB_USER=postgres
SMS_DB_PASSWORD=postgres

# Database - email_db
EMAIL_DB_HOST=localhost
EMAIL_DB_PORT=5434
EMAIL_DB_NAME=email_db
EMAIL_DB_USER=postgres
EMAIL_DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:rabbitmq@localhost:5672

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=10

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@example.com

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://localhost:3001
SMS_SERVICE_URL=http://localhost:3002
EMAIL_SERVICE_URL=http://localhost:3003
LOG_SERVICE_URL=http://localhost:3004

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
