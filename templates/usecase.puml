@startuml
' ============================================================
' Use Case Diagram Template
' Copy and customize for your project
'
' Tips:
' - No system boundary rectangle needed
' - Use nodesep/ranksep to control spacing
' - Use hidden links between actors to control order
' - <<include>> = mandatory sub-flow
' - <<extend>> = optional/conditional sub-flow
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
}

' --- Spacing ---
skinparam nodesep 60
skinparam ranksep 40

' --- Actors ---
actor "User" as user
actor "Admin" as admin
actor "System" as system

' --- Force actor order ---
user -[hidden]down- admin
admin -[hidden]down- system

' --- Use Cases ---
usecase "UC-01: Login" as UC01
usecase "UC-02: View Dashboard" as UC02
usecase "UC-03: Logout" as UC03
usecase "UC-04: Manage Users" as UC04
usecase "UC-05: Manage Roles" as UC05
usecase "UC-06: Generate Report" as UC06
usecase "UC-07: Send Notification" as UC07

' --- Relationships ---
user --> UC01
user --> UC02
user --> UC03
admin --> UC04
admin --> UC05
system --> UC06
system --> UC07

' --- Include/Extend ---
UC02 ..> UC01 : <<include>>
UC07 ..> UC06 : <<extend>>

@enduml
