@startuml
' ============================================================
' Use Case Diagram Template
' Copy and customize for your project
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

' --- Actors ---
actor "User" as user
actor "Admin" as admin
actor "System" as system

' --- System Boundary ---
rectangle "System Name" {
  ' --- Use Cases ---
  usecase "UC-01: Login" as UC01
  usecase "UC-02: View Dashboard" as UC02
  usecase "UC-03: Manage Users" as UC03
  usecase "UC-04: Generate Report" as UC04
  usecase "UC-05: Send Notification" as UC05
}

' --- Relationships ---
user --> UC01
user --> UC02
admin --> UC03
admin --> UC04
system --> UC05

' --- Include/Extend ---
UC02 ..> UC01 : <<include>>
UC05 ..> UC04 : <<extend>>

@enduml
