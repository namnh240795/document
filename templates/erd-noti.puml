@startuml
' ============================================================
' ERD: Notification Database (noti_db)
' Modules: NOTI
' Tables: xxx_notification_templates, xxx_notification_logs, xxx_sms_logs
'
' RULE: Replace "xxx" with your project short name
' ============================================================

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}

title Notification Database (noti_db)

entity "xxx_notification_templates" as notif_templates {
  * id : uuid <<PK>>
  --
  * name : varchar(100) <<UNIQUE>>
  * type : enum('email','sms','push')
  * subject : varchar(200)
  * body : text
  * is_active : boolean DEFAULT true
  * created_at : timestamp
  * updated_at : timestamp
}

entity "xxx_notification_logs" as notif_logs {
  * id : uuid <<PK>>
  --
  * user_id : uuid  ' Application-level reference to auth_db.xxx_users
  * template_id : uuid <<FK>>
  * channel : enum('email','sms','push')
  * status : enum('pending','sent','failed','read')
  * recipient : varchar(255)
  * sent_at : timestamp
  * read_at : timestamp
  * error_message : text
  * created_at : timestamp
}

entity "xxx_sms_logs" as sms_logs {
  * id : uuid <<PK>>
  --
  * user_id : uuid  ' Application-level reference
  * phone : varchar(20)
  * message : text
  * status : enum('pending','sent','failed','delivered')
  * provider : varchar(50)
  * provider_response : jsonb
  * sent_at : timestamp
  * delivered_at : timestamp
  * created_at : timestamp
}

' --- Relationships ---
notif_templates ||--o{ notif_logs : "uses"

@enduml
