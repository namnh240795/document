@startuml
' ============================================================
' ERD: Email Database (email_db)
' Tables: email_logs
' ============================================================

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}

title Email Database (email_db)

entity "email_logs" as email_logs {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * email : varchar(255)
  * subject : varchar(500)
  * template_id : varchar(100)
  * status : enum('pending','sent','delivered','failed')
  * provider : varchar(50)
  * provider_message_id : varchar(100)
  * error_message : text
  * retry_count : integer
  * metadata : jsonb
  * sent_at : timestamp
  * delivered_at : timestamp
  * created_at : timestamp
}

@enduml
