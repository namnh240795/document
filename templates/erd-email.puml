@startuml
' ============================================================
' ERD: Email Database (email_db)
' Tables: email_logs
' Note: user_id references auth_users in auth_db (application-level, no FK constraint)
' ============================================================

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}

title Email Database (email_db)

entity "email_logs" as email_logs {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<APP-LEVEL REF>>
  * email : varchar(255)
  * subject : varchar(500)
  * template_id : varchar(100)
  * status : enum('pending','sent','delivered','failed')
  * provider : varchar(50)
  * provider_message_id : varchar(100)
  * error_message : text
  * retry_count : integer
  * metadata : jsonb
  * sent_at : timestamp
  * delivered_at : timestamp
  * created_at : timestamp
}

note bottom of email_logs
  user_id references auth_users.id in auth_db.
  Cross-database reference — no FK constraint.
  Enforced at application level only.
end note

@enduml
