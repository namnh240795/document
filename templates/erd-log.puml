@startuml
' ============================================================
' ERD: Logger Module (OpenSearch as Primary Store)
' ============================================================

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}

title Logger Module - OpenSearch Index Schema

package "OpenSearch (index: log-events)" as os {
  entity "log-events" as log_index {
    * eventId : keyword <<PK>>
    --
    * source : text + keyword
    * level : keyword
    * action : keyword
    * message : text
    * input : text
    * output : text
    * error : text
    * exception : text
    * traceId : keyword
    * userId : keyword
    * metadata : object
    * timestamp : date
  }
}

note top of os
  OpenSearch is the primary store.
  Handles search, analytics, dashboards.
  No PostgreSQL needed.
end note

@enduml
