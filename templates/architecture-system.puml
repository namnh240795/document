@startuml
' ============================================================
' System Architecture - Authentication System
' Clear, well-organized with labels and data flow
' ============================================================

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
  FontSize 12
}

skinparam database {
  BackgroundColor #E8F4E8
  BorderColor #333333
  FontSize 12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #333333
  FontSize 12
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 14
}

title System Architecture: Authentication System

' ============================================================
' CLIENTS
' ============================================================
package "Clients" #F5F5F5 {
  component "Web App\n(React/Next.js)" as web
  component "Mobile App\n(React Native)" as mobile
}

' ============================================================
' GATEWAY
' ============================================================
package "API Gateway" #E3F2FD {
  component "NestJS Gateway\n- Rate Limiting\n- JWT Validation\n- Request Routing" as gateway
}

' ============================================================
' CORE SERVICES
' ============================================================
package "Core Services" #F5F5F5 {
  component "AUTH Service\n- User Registration\n- Login/Logout\n- Session Management\n- RBAC\n- Invitations" as auth

  component "SMS Service\n- OTP Generation\n- SMS Delivery\n- Delivery Tracking" as sms

  component "EMAIL Service\n- Email Delivery\n- Templating\n- Audit Trail" as email

  component "RECR Service\n- Job Postings\n- Applications\n- Interviews\n- Offers" as recr

  component "WALLET Service\n- Payments\n- Deposits\n- Withdrawals" as wallet

  component "LOG Service\n- Event Ingestion\n- Log Query\n- Analytics" as log
}

' ============================================================
' MESSAGE BROKER
' ============================================================
package "Message Broker" #FFF3E0 {
  queue "RabbitMQ" as mq
}

' ============================================================
' DATA STORAGE
' ============================================================
package "Data Storage" #F5F5F5 {
  database "PostgreSQL\nauth_db\n- users\n- sessions\n- roles\n- invitations" as pgAuth

  database "PostgreSQL\nsms_db\n- sms_logs" as pgSms

  database "PostgreSQL\nemail_db\n- email_logs\n- templates" as pgEmail

  database "PostgreSQL\nrecr_db\n- jobs\n- applications\n- interviews" as pgRecr

  database "PostgreSQL\nwallet_db\n- wallets\n- transactions" as pgWallet

  database "OpenSearch\nlog-events\n- Full-text search\n- Analytics" as os
}

' ============================================================
' EXTERNAL SERVICES
' ============================================================
package "External Services" #F3E5F5 {
  component "Twilio\n(SMS Provider)" as twilio
  component "SendGrid/SMTP\n(Email Provider)" as sendgrid
}

' ============================================================
' DATA FLOW - REST API
' ============================================================
web --> gateway : HTTPS
mobile --> gateway : HTTPS

gateway --> auth : REST API
gateway --> sms : REST API
gateway --> email : REST API
gateway --> recr : REST API
gateway --> wallet : REST API
gateway --> log : REST API

' ============================================================
' DATA FLOW - Database
' ============================================================
auth --> pgAuth : SQL
sms --> pgSms : SQL
email --> pgEmail : SQL
recr --> pgRecr : SQL
wallet --> pgWallet : SQL
log --> os : REST API

' ============================================================
' DATA FLOW - Message Queue
' ============================================================
auth --> mq : Publish

sms --> mq : Publish

email --> mq : Publish

recr --> mq : Publish

wallet --> mq : Publish

mq --> sms : Consume

mq --> email : Consume

mq --> recr : Consume

mq --> wallet : Consume

mq --> log : Consume

' ============================================================
' DATA FLOW - External
' ============================================================
sms --> twilio : Send SMS\n(Twilio API)
twilio --> sms : Delivery Webhook

email --> sendgrid : Send Email\n(SendGrid/SMTP)
sendgrid --> email : Delivery Webhook

@enduml
