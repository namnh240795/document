@startuml
' ============================================================
' System Architecture - Authentication System
' Clear, well-organized with labels and data flow
' ============================================================

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
  FontSize 12
}

skinparam database {
  BackgroundColor #E8F4E8
  BorderColor #333333
  FontSize 12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #333333
  FontSize 12
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 14
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #FFC107
  FontSize 11
}

title System Architecture: Authentication System

' ============================================================
' CLIENTS
' ============================================================
package "Clients" #F5F5F5 {
  component "Web App\n(React/Next.js)" as web
  component "Mobile App\n(React Native)" as mobile
}

' ============================================================
' GATEWAY
' ============================================================
package "API Gateway" #E3F2FD {
  component "NestJS Gateway\n- Rate Limiting\n- JWT Validation\n- Request Routing" as gateway
}

' ============================================================
' CORE SERVICES
' ============================================================
package "Core Services" #F5F5F5 {
  component "AUTH Service\n- User Registration\n- Login/Logout\n- Session Management\n- RBAC" as auth

  component "SMS Service\n- OTP Generation\n- SMS Delivery\n- Delivery Tracking" as sms

  component "LOG Service\n- Event Ingestion\n- Log Query\n- Analytics" as log
}

' ============================================================
' MESSAGE BROKER
' ============================================================
package "Message Broker" #FFF3E0 {
  queue "RabbitMQ\n(log.events)" as mq
}

' ============================================================
' DATA STORAGE
' ============================================================
package "Data Storage" #F5F5F5 {
  database "PostgreSQL\nauth_db\n- users\n- sessions\n- roles" as pgAuth

  database "PostgreSQL\nsms_db\n- sms_logs" as pgSms

  database "OpenSearch\nlog-events\n- Full-text search\n- Analytics" as os
}

' ============================================================
' EXTERNAL SERVICES
' ============================================================
package "External Services" #F3E5F5 {
  component "Twilio\n(SMS Provider)" as twilio
}

' ============================================================
' DATA FLOW - REST API
' ============================================================
web --> gateway : HTTPS
mobile --> gateway : HTTPS

gateway --> auth : REST API
gateway --> sms : REST API
gateway --> log : REST API

' ============================================================
' DATA FLOW - Database
' ============================================================
auth --> pgAuth : SQL
sms --> pgSms : SQL
log --> os : REST API

' ============================================================
' DATA FLOW - Message Queue
' ============================================================
auth --> mq : Publish\n- verification.requested\n- verification.resent\n- auth.event.logged

sms --> mq : Publish\n- sms.event.logged

mq --> sms : Consume\n- verification.requested
mq --> log : Consume\n- auth.event.logged\n- sms.event.logged

' ============================================================
' DATA FLOW - External
' ============================================================
sms --> twilio : Send SMS\n(Twilio API)
twilio --> sms : Delivery Webhook

' ============================================================
' NOTES
' ============================================================
note right of auth
  AUTH Module:
  - User CRUD
  - JWT Tokens
  - Role Management
  - Verification Flow
end note

note right of sms
  SMS Module:
  - OTP Generation
  - Twilio Integration
  - Delivery Tracking
  - Audit Logs
end note

note right of log
  LOG Module:
  - Event Ingestion
  - Full-text Search
  - Analytics
  - Real-time Monitoring
end note

note bottom of mq
  RabbitMQ Queues:
  - log.events (all services)
  - verification.sms (AUTH -> SMS)
end note

@enduml
