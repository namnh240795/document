@startuml
' ============================================================
' System Architecture - Authentication System
' Straight arrows, Message Broker at bottom
' ============================================================

top to bottom direction

skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam rectangle {
  RoundCorner 6
  BorderColor #333333
  FontSize 13
  FontStyle bold
  FontColor #000000
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 11
  FontColor #000000
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
  FontColor #000000
}

skinparam queue {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
  FontColor #000000
}

skinparam arrow {
  Color #000000
  Thickness 2
}

title System Architecture

' ============================================================
' LAYER 1 - Clients
' ============================================================
rectangle "  Clients  " as clients #FFFFFF {
  component "Web App" as web
  component "Mobile App" as mobile
}

' ============================================================
' LAYER 2 - Gateway
' ============================================================
rectangle "  API Gateway  " as gw #FFD54F {
  component "NestJS Gateway" as gateway
}

' ============================================================
' LAYER 3 - Core Services
' ============================================================
rectangle "  Core Services  " as services #FFFFFF {
  component "AUTH" as auth
  component "SMS" as sms
  component "EMAIL" as email
  component "RECR" as recr
  component "WALLET" as wallet
  component "LOG" as log
}

' ============================================================
' LAYER 4 - Data Storage
' ============================================================
rectangle "  Data Storage  " as storage #FFFFFF {
  database "PostgreSQL" as pg
  database "OpenSearch" as os
}

' ============================================================
' LAYER 5 - External Services
' ============================================================
rectangle "  External Services  " as external #FFFFFF {
  component "Twilio" as twilio
  component "SendGrid" as sendgrid
}

' ============================================================
' LAYER 6 - Message Broker (bottom)
' ============================================================
rectangle "  Message Broker  " as broker #FFD54F {
  queue "RabbitMQ" as mq
}

' ============================================================
' LAYOUT FORCING
' ============================================================
clients -[hidden]down-> gw
gw -[hidden]down-> services
services -[hidden]down-> storage
storage -[hidden]down-> external
external -[hidden]down-> broker

' ============================================================
' CONNECTIONS
' ============================================================
clients -down-> gw
gw -down-> services
services -down-> storage
storage -down-> external
external -down-> broker

@enduml
