@startuml
' ============================================================
' System Architecture - Authentication System
' Minimal: yellow + black/white
' ============================================================

top to bottom direction

skinparam linetype ortho
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam rectangle {
  RoundCorner 6
  BorderColor #333333
  FontSize 13
  FontStyle bold
  FontColor #000000
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 11
  FontColor #000000
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
  FontColor #000000
}

skinparam queue {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
  FontColor #000000
}

skinparam arrow {
  Color #000000
  Thickness 2
}

title System Architecture

' ============================================================
' LAYOUT
' ============================================================

rectangle "  Clients  " as clients #FFFFFF {
  component "Web App" as web
  component "Mobile App" as mobile
}

rectangle "  API Gateway  " as gw #FFD54F {
  component "NestJS Gateway" as gateway
}

rectangle "  Core Services  " as services #FFFFFF {
  component "AUTH" as auth
  component "SMS" as sms
  component "EMAIL" as email
  component "RECR" as recr
  component "WALLET" as wallet
  component "LOG" as log
}

rectangle "  Message Broker  " as broker #FFD54F {
  queue "RabbitMQ" as mq
}

rectangle "  Data Storage  " as storage #FFFFFF {
  database "PostgreSQL" as pg
  database "OpenSearch" as os
}

rectangle "  External Services  " as external #FFFFFF {
  component "Twilio" as twilio
  component "SendGrid" as sendgrid
}

' ============================================================
' LAYOUT FORCING
' ============================================================
clients -[hidden]down-> gw
gw -[hidden]down-> services
services -[hidden]down-> storage
services -[hidden]down-> external
services -[hidden]right-> broker
storage -[hidden]right-> external

' ============================================================
' CONNECTIONS
' ============================================================
clients -down-> gw
gw -down-> services
services -down-> storage
services -right-> broker
broker -left-> services
storage -right-> external
external -left-> storage

@enduml
