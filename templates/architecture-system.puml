@startuml
' ============================================================
' System Architecture - Authentication System
' ============================================================

!define ICONCOLOR #2196F3
!define SERVCOLOR #1565C0
!define DBCOLOR #2E7D32
!define MQCOLOR #E65100
!define EXTCOLOR #6A1B9A

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

skinparam rectangle {
  RoundCorner 10
  BorderColor #BDBDBD
  FontSize 14
  FontStyle bold
}

skinparam component {
  BackgroundColor #FAFAFA
  BorderColor #E0E0E0
  ArrowColor #424242
  FontSize 11
}

skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #4CAF50
  FontSize 11
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #FF9800
  FontSize 11
}

skinparam arrow {
  Color #616161
  Thickness 2
}

title System Architecture

' ============================================================
' LAYOUT - Left to Right flow
' ============================================================

rectangle "  Clients  " as clients #E3F2FD {
  component "Web App" as web
  component "Mobile App" as mobile
}

rectangle "  API Gateway  " as gw #BBDEFB {
  component "NestJS\nGateway" as gateway
}

rectangle "  Core Services  " as services #F5F5F5 {
  component "AUTH" as auth #E3F2FD
  component "SMS" as sms #E8F5E9
  component "EMAIL" as email #FFF3E0
  component "RECR" as recr #F3E5F5
  component "WALLET" as wallet #E0F7FA
  component "LOG" as log #FCE4EC
}

rectangle "  Message Broker  " as broker #FFF3E0 {
  queue "RabbitMQ" as mq
}

rectangle "  Data Storage  " as storage #F5F5F5 {
  database "PostgreSQL" as pg #E8F5E9
  database "OpenSearch" as os #F3E5F5
}

rectangle "  External  " as external #F3E5F5 {
  component "Twilio" as twilio #E8F5E9
  component "SendGrid" as sendgrid #E3F2FD
}

' ============================================================
' CONNECTIONS
' ============================================================
clients -down-> gw
gw -down-> services
services -down-> storage
services -right-> broker
broker -left-> services
services -down-> external
external -up-> services

@enduml
