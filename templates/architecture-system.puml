@startuml
' ============================================================
' System Architecture - Authentication System
' ============================================================

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
  FontSize 12
}

skinparam database {
  BackgroundColor #E8F4E8
  BorderColor #333333
  FontSize 12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #333333
  FontSize 12
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 14
}

title System Architecture: Authentication System

' ============================================================
' CLIENTS
' ============================================================
package "Clients" #F5F5F5 {
  component "Web App\n(React/Next.js)" as web
  component "Mobile App\n(React Native)" as mobile
}

' ============================================================
' GATEWAY
' ============================================================
package "API Gateway" #E3F2FD {
  component "NestJS Gateway" as gateway
}

' ============================================================
' CORE SERVICES
' ============================================================
package "Core Services" #F5F5F5 {
  component "AUTH" as auth
  component "SMS" as sms
  component "EMAIL" as email
  component "RECR" as recr
  component "WALLET" as wallet
  component "LOG" as log
}

' ============================================================
' MESSAGE BROKER
' ============================================================
package "Message Broker" #FFF3E0 {
  queue "RabbitMQ" as mq
}

' ============================================================
' DATA STORAGE
' ============================================================
package "Data Storage" #F5F5F5 {
  database "auth_db" as pgAuth
  database "sms_db" as pgSms
  database "email_db" as pgEmail
  database "recr_db" as pgRecr
  database "wallet_db" as pgWallet
  database "OpenSearch" as os
}

' ============================================================
' EXTERNAL SERVICES
' ============================================================
package "External Services" #F3E5F5 {
  component "Twilio" as twilio
  component "SendGrid" as sendgrid
}

' ============================================================
' DATA FLOW
' ============================================================
web --> gateway
mobile --> gateway

gateway --> auth

auth --> pgAuth
sms --> pgSms
email --> pgEmail
recr --> pgRecr
wallet --> pgWallet
log --> os

auth --> mq
sms --> mq
email --> mq
recr --> mq
wallet --> mq

mq --> log

sms --> twilio
twilio --> sms

email --> sendgrid
sendgrid --> email

@enduml
