@startuml
' ============================================================
' System Architecture - Authentication System
' ============================================================

!pragma layout smetana
top to bottom direction

skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam nodesep 40
skinparam ranksep 50

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 11
  FontColor #000000
  RoundCorner 6
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
  FontColor #000000
}

skinparam queue {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
  FontColor #000000
}

skinparam arrow {
  Color #000000
  Thickness 2
}

skinparam linetype polyline

title System Architecture

' Gateway
component "API Gateway" as gw #FFD54F

' Core Services (Web App same layer)
component "Web App" as web
component "AUTH" as auth
component "SMS" as sms
component "EMAIL" as email
component "RECR" as recr
component "WALLET" as wallet
component "LOG" as log

' Infrastructure
database "PostgreSQL" as pg
database "OpenSearch" as os
component "Twilio" as twilio
component "SendGrid" as sendgrid
queue "RabbitMQ" as mq #FFD54F

' Gateway -> Services
gw -down-> web
gw -down-> auth
gw -down-> sms
gw -down-> email
gw -down-> recr
gw -down-> wallet
gw -down-> log

' Services -> Infrastructure
auth -down-> pg
auth -down-> os
sms -down-> twilio
email -down-> sendgrid
log -down-> mq

' Row alignment: services
web -[hidden]right-> auth
auth -[hidden]right-> sms
sms -[hidden]right-> email
email -[hidden]right-> recr
recr -[hidden]right-> wallet
wallet -[hidden]right-> log

' Row alignment: infrastructure
pg -[hidden]right-> os
os -[hidden]right-> twilio
twilio -[hidden]right-> sendgrid
sendgrid -[hidden]right-> mq

@enduml
