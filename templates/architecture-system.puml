@startuml
' ============================================================
' System Architecture - Authentication System
' Clear, well-organized with labels and data flow
' ============================================================

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
  FontSize 12
}

skinparam database {
  BackgroundColor #E8F4E8
  BorderColor #333333
  FontSize 12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #333333
  FontSize 12
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 14
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #FFC107
  FontSize 11
}

title System Architecture: Authentication System

' ============================================================
' CLIENTS
' ============================================================
package "Clients" #F5F5F5 {
  component "Web App\n(React/Next.js)" as web
  component "Mobile App\n(React Native)" as mobile
}

' ============================================================
' GATEWAY
' ============================================================
package "API Gateway" #E3F2FD {
  component "NestJS Gateway\n- Rate Limiting\n- JWT Validation\n- Request Routing" as gateway
}

' ============================================================
' CORE SERVICES
' ============================================================
package "Core Services" #F5F5F5 {
  component "AUTH Service\n- User Registration\n- Login/Logout\n- Session Management\n- RBAC\n- Invitations" as auth

  component "SMS Service\n- OTP Generation\n- SMS Delivery\n- Delivery Tracking" as sms

  component "EMAIL Service\n- Email Delivery\n- Templating\n- Audit Trail" as email

  component "RECR Service\n- Job Postings\n- Applications\n- Interviews\n- Offers" as recr

  component "WALLET Service\n- Payments\n- Deposits\n- Withdrawals" as wallet

  component "LOG Service\n- Event Ingestion\n- Log Query\n- Analytics" as log
}

' ============================================================
' MESSAGE BROKER
' ============================================================
package "Message Broker" #FFF3E0 {
  queue "RabbitMQ" as mq
}

' ============================================================
' DATA STORAGE
' ============================================================
package "Data Storage" #F5F5F5 {
  database "PostgreSQL\nauth_db\n- users\n- sessions\n- roles\n- invitations" as pgAuth

  database "PostgreSQL\nsms_db\n- sms_logs" as pgSms

  database "PostgreSQL\nemail_db\n- email_logs\n- templates" as pgEmail

  database "PostgreSQL\nrecr_db\n- jobs\n- applications\n- interviews" as pgRecr

  database "PostgreSQL\nwallet_db\n- wallets\n- transactions" as pgWallet

  database "OpenSearch\nlog-events\n- Full-text search\n- Analytics" as os
}

' ============================================================
' EXTERNAL SERVICES
' ============================================================
package "External Services" #F3E5F5 {
  component "Twilio\n(SMS Provider)" as twilio
  component "SendGrid/SMTP\n(Email Provider)" as sendgrid
}

' ============================================================
' DATA FLOW - REST API
' ============================================================
web --> gateway : HTTPS
mobile --> gateway : HTTPS

gateway --> auth : REST API
gateway --> sms : REST API
gateway --> email : REST API
gateway --> recr : REST API
gateway --> wallet : REST API
gateway --> log : REST API

' ============================================================
' DATA FLOW - Database
' ============================================================
auth --> pgAuth : SQL
sms --> pgSms : SQL
email --> pgEmail : SQL
recr --> pgRecr : SQL
wallet --> pgWallet : SQL
log --> os : REST API

' ============================================================
' DATA FLOW - Message Queue
' ============================================================
auth --> mq : Publish\n- verification.requested\n- verification.email.requested\n- invitation.created\n- user.registered\n- auth.event.logged

sms --> mq : Publish\n- sms.event.logged

email --> mq : Publish\n- email.event.logged

recr --> mq : Publish\n- application.submitted\n- interview.scheduled\n- offer.sent\n- recr.event.logged

wallet --> mq : Publish\n- wallet.event.logged

mq --> sms : Consume\n- verification.requested

mq --> email : Consume\n- verification.email.requested\n- invitation.created

mq --> recr : Consume\n- wallet.payment.completed

mq --> wallet : Consume\n- user.registered

mq --> log : Consume\n- auth.event.logged\n- sms.event.logged\n- email.event.logged\n- recr.event.logged\n- wallet.event.logged

' ============================================================
' DATA FLOW - External
' ============================================================
sms --> twilio : Send SMS\n(Twilio API)
twilio --> sms : Delivery Webhook

email --> sendgrid : Send Email\n(SendGrid/SMTP)
sendgrid --> email : Delivery Webhook

' ============================================================
' NOTES
' ============================================================
note right of auth
  AUTH Module:
  - User CRUD
  - JWT Tokens
  - Role Management
  - Verification Flow
end note

note right of sms
  SMS Module:
  - OTP Generation
  - Twilio Integration
  - Delivery Tracking
  - Audit Logs
end note

note right of email
  EMAIL Module:
  - Email Delivery
  - Template Management
  - SendGrid/SMTP Integration
  - Audit Trail
end note

note right of recr
  RECR Module:
  - Job Postings
  - Candidate Applications
  - Interview Scheduling
  - Offer Management
end note

note right of wallet
  WALLET Module:
  - Electronic Wallets
  - Deposits/Withdrawals
  - Payment Processing
  - Transaction History
end note

note right of log
  LOG Module:
  - Event Ingestion
  - Full-text Search
  - Analytics
  - Real-time Monitoring
end note

note bottom of mq
  RabbitMQ Queues:
  - verification.sms (AUTH -> SMS)
  - verification.email (AUTH -> EMAIL)
  - invitation.email (AUTH -> EMAIL)
  - wallet.events (AUTH -> WALLET)
  - log.events (all services -> LOG)
end note

@enduml
