@startuml
' ============================================================
' System Architecture - Authentication System
' ============================================================

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 14
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
  FontSize 12
}

skinparam database {
  BackgroundColor #E8F4E8
  BorderColor #333333
  FontSize 12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #333333
  FontSize 12
}

title System Architecture: Authentication System

' ============================================================
' LAYOUT
' ============================================================
rectangle "Clients" as clients #F5F5F5 {
  component "Web App" as web
  component "Mobile App" as mobile
}

rectangle "API Gateway" as gw #E3F2FD {
  component "NestJS Gateway" as gateway
}

rectangle "Core Services" as services #F5F5F5 {
  component "AUTH" as auth
  component "SMS" as sms
  component "EMAIL" as email
  component "RECR" as recr
  component "WALLET" as wallet
  component "LOG" as log
}

rectangle "Message Broker" as broker #FFF3E0 {
  queue "RabbitMQ" as mq
}

rectangle "Data Storage" as storage #F5F5F5 {
  database "PostgreSQL" as pg
  database "OpenSearch" as os
}

rectangle "External Services" as external #F3E5F5 {
  component "Twilio" as twilio
  component "SendGrid" as sendgrid
}

' ============================================================
' CONNECTIONS - Rectangle to Rectangle
' ============================================================
clients -down-> gw : HTTPS
gw -down-> services : REST API
services -down-> storage : SQL
services -right-> broker : Pub/Sub
broker -left-> services : Pub/Sub
services -down-> external : API
external -up-> services : Webhooks

@enduml
