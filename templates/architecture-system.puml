@startuml
' ============================================================
' System Architecture - Authentication System
' Grid layout: no arrow overlap
' ============================================================

skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam rectangle {
  RoundCorner 8
  BorderColor #78909C
  FontSize 13
  FontStyle bold
  FontColor #263238
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  ArrowColor #37474F
  FontSize 11
  FontColor #263238
}

skinparam database {
  BackgroundColor #C8E6C9
  BorderColor #388E3C
  FontSize 11
  FontColor #1B5E20
}

skinparam queue {
  BackgroundColor #FFE0B2
  BorderColor #EF6C00
  FontSize 11
  FontColor #E65100
}

skinparam arrow {
  Color #455A64
  Thickness 2
}

title System Architecture

' ============================================================
' ROW 1 - Clients
' ============================================================
rectangle "  Clients  " as clients #E3F2FD {
  component "Web App" as web #BBDEFB
  component "Mobile App" as mobile #BBDEFB
}

' ============================================================
' ROW 2 - Gateway
' ============================================================
rectangle "  API Gateway  " as gw #90CAF9 {
  component "NestJS Gateway" as gateway #42A5F5
}

' ============================================================
' ROW 3 - Core Services (center) | Message Broker (right)
' ============================================================
rectangle "  Core Services  " as services #ECEFF1 {
  component "AUTH" as auth #42A5F5
  component "SMS" as sms #66BB6A
  component "EMAIL" as email #FFA726
  component "RECR" as recr #AB47BC
  component "WALLET" as wallet #26C6DA
  component "LOG" as log #EF5350
}

rectangle "  Message Broker  " as broker #FFE0B2 {
  queue "RabbitMQ" as mq #FF9800
}

' ============================================================
' ROW 4 - Data Storage (left) | External (right)
' ============================================================
rectangle "  Data Storage  " as storage #C8E6C9 {
  database "PostgreSQL" as pg #4CAF50
  database "OpenSearch" as os #9C27B0
}

rectangle "  External Services  " as external #F3E5F5 {
  component "Twilio" as twilio #26A69A
  component "SendGrid" as sendgrid #42A5F5
}

' ============================================================
' LAYOUT FORCING (hidden arrows)
' ============================================================
' Force grid: row by row
clients -[hidden]down-> gw
gw -[hidden]down-> services
services -[hidden]down-> storage
services -[hidden]down-> external

' Force services and broker on same row
services -[hidden]right-> broker

' Force storage and external on same row
storage -[hidden]right-> external

' ============================================================
' REAL CONNECTIONS
' ============================================================
clients -down-> gw : HTTPS
gw -down-> services : REST API
services -down-> storage : SQL
services -right-> broker : Pub/Sub
broker -left-> services : Pub/Sub
storage -right-> external : API
external -left-> storage : Webhooks

@enduml
