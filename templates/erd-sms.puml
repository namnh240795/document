@startuml
' ============================================================
' ERD: SMS Database (sms_db)
' Tables: sms_logs
' Note: user_id references auth_users in auth_db (application-level, no FK constraint)
' ============================================================

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}

title SMS Database (sms_db)

entity "sms_logs" as sms_logs {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<APP-LEVEL REF>>
  * phone : varchar(20)
  * message : text
  * otp_code : varchar(10)
  * status : enum('pending','sent','delivered','failed')
  * provider : varchar(50)
  * provider_message_id : varchar(100)
  * error_message : text
  * retry_count : integer
  * expires_at : timestamp
  * sent_at : timestamp
  * delivered_at : timestamp
  * created_at : timestamp
}

note bottom of sms_logs
  user_id references auth_users.id in auth_db.
  Cross-database reference — no FK constraint.
  Enforced at application level only.
end note

@enduml
