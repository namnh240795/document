@startuml Sample Sequence - Order Checkout Flow

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
  ParticipantFontSize 12
  ArrowFontSize 11
}

title Sequence Diagram - Order Checkout Flow (UC-11)

actor "Customer" as C
participant "Web App\n(Frontend)" as FE
participant "API Gateway" as GW
participant "Order Service" as OS
participant "Inventory Service" as IS
participant "Payment Service" as PS
database "Order DB" as ODB
database "Inventory DB" as IDB
queue "Event Bus" as MQ
participant "Notification Service" as NS
participant "Email Service" as ES

== Step 1: Checkout Request ==

C -> FE : Click "Checkout"
activate FE

FE -> GW : POST /api/v1/orders/checkout
note right: { cartId, addressId, paymentMethod }
activate GW

GW -> OS : Process Checkout
activate OS

== Step 2: Validate Inventory ==

OS -> IS : Check Stock Availability
activate IS

IS -> IDB : SELECT stock WHERE product_id IN (...)
activate IDB
IDB --> IS : Stock Results
deactivate IDB

alt All items in stock
  IS --> OS : Stock Available
  deactivate IS
else Item out of stock
  IS --> OS : Stock Insufficient
  deactivate IS
  OS --> GW : 409 Conflict
  GW --> FE : 409 - Items out of stock
  FE --> C : Show error message
end

== Step 3: Reserve Inventory ==

OS -> IS : Reserve Stock
activate IS
IS -> IDB : UPDATE stock SET reserved = reserved + qty
activate IDB
IDB --> IS : Reserved
deactivate IDB
IS --> OS : Reserved
deactivate IS

== Step 4: Create Order ==

OS -> ODB : INSERT order + order_items
activate ODB
ODB --> OS : Order Created (orderId)
deactivate ODB

== Step 5: Process Payment ==

OS -> PS : Process Payment
activate PS

PS -> PS : Validate payment details
PS -> PS : Charge amount

alt Payment successful
  PS --> OS : Payment Success
  deactivate PS
  OS -> ODB : UPDATE order SET status = 'confirmed'
  activate ODB
  ODB --> OS : Updated
  deactivate ODB
else Payment failed
  PS --> OS : Payment Failed
  deactivate PS
  OS -> IS : Release Reserved Stock
  activate IS
  IS -> IDB : UPDATE stock SET reserved = reserved - qty
  IDB --> IS : Released
  deactivate IDB
  IS --> OS : Released
  deactivate IS
  OS -> ODB : UPDATE order SET status = 'payment_failed'
  ODB --> OS : Updated
  deactivate ODB
  OS --> GW : 402 Payment Required
  GW --> FE : 402
  FE --> C : Show payment error
end

== Step 6: Send Notifications ==

OS -> MQ : Publish "order.created"
activate MQ
MQ --> OS : Published
deactivate MQ

MQ -> NS : Consume "order.created"
activate NS
NS -> ES : Send Order Confirmation Email
activate ES
ES -> ES : Send email to customer
ES --> NS : Sent
deactivate ES
NS --> MQ : Ack
deactivate NS

== Step 7: Response ==

OS --> GW : 201 Order Created
deactivate OS

GW --> FE : { orderId, orderNumber, total }
deactivate GW

FE --> C : Show Order Confirmation
deactivate FE

note over C, ES
  End of Checkout Flow
  Order Status: CONFIRMED
  Stock: RESERVED
  Payment: COMPLETED
  Email: SENT
end note

@enduml
