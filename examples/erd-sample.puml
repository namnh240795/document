@startuml Sample ERD - E-Commerce System

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}

title E-Commerce System - Entity Relationship Diagram

' --- Users & Auth ---
entity "users" as users {
  * id : bigint <<PK>>
  --
  * username : varchar(50) <<UNIQUE>>
  * email : varchar(100) <<UNIQUE>>
  * password_hash : varchar(255)
  * full_name : varchar(100)
  * phone : varchar(20)
  * role : enum('admin','staff','customer')
  * status : enum('active','inactive','banned')
  * last_login : timestamp
  * created_at : timestamp
  * updated_at : timestamp
}

entity "addresses" as addresses {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * label : varchar(50)
  * street : varchar(255)
  * city : varchar(100)
  * state : varchar(100)
  * zip_code : varchar(20)
  * country : varchar(50)
  * is_default : boolean
}

' --- Product Catalog ---
entity "categories" as categories {
  * id : bigint <<PK>>
  --
  * name : varchar(100)
  * slug : varchar(100) <<UNIQUE>>
  * description : text
  * parent_id : bigint <<FK>>
  * sort_order : int
  * is_active : boolean
}

entity "products" as products {
  * id : bigint <<PK>>
  --
  * category_id : bigint <<FK>>
  * name : varchar(200)
  * slug : varchar(200) <<UNIQUE>>
  * description : text
  * sku : varchar(50) <<UNIQUE>>
  * price : decimal(10,2)
  * cost_price : decimal(10,2)
  * stock_quantity : int
  * weight : decimal(8,2)
  * status : enum('draft','active','archived')
  * created_at : timestamp
  * updated_at : timestamp
}

entity "product_images" as product_images {
  * id : bigint <<PK>>
  --
  * product_id : bigint <<FK>>
  * url : varchar(500)
  * alt_text : varchar(200)
  * sort_order : int
  * is_primary : boolean
}

' --- Orders ---
entity "orders" as orders {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * order_number : varchar(20) <<UNIQUE>>
  * status : enum('pending','confirmed','processing','shipped','delivered','cancelled')
  * subtotal : decimal(10,2)
  * tax_amount : decimal(10,2)
  * shipping_fee : decimal(10,2)
  * discount_amount : decimal(10,2)
  * total_amount : decimal(10,2)
  * shipping_address_id : bigint <<FK>>
  * notes : text
  * created_at : timestamp
  * updated_at : timestamp
}

entity "order_items" as order_items {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * product_id : bigint <<FK>>
  * quantity : int
  * unit_price : decimal(10,2)
  * subtotal : decimal(10,2)
}

' --- Payments ---
entity "payments" as payments {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * method : enum('cod','bank_transfer','credit_card','e_wallet')
  * status : enum('pending','completed','failed','refunded')
  * amount : decimal(10,2)
  * transaction_id : varchar(100)
  * paid_at : timestamp
  * created_at : timestamp
}

' --- Relationships ---
users ||--o{ addresses : "has"
users ||--o{ orders : "places"

categories ||--o{ products : "categorizes"
categories ||--o{ categories : "parent"
products ||--o{ product_images : "has"
products ||--o{ order_items : "included in"

orders ||--o{ order_items : "contains"
orders ||--o{ payments : "paid via"
addresses <.. orders : "shipped to"

@enduml
