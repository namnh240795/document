@startuml Sample UseCase - E-Commerce System

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title E-Commerce System - Use Case Diagram

' --- Actors ---
actor "Customer" as customer
actor "Staff" as staff
actor "Admin" as admin
actor "Payment Gateway" as payment
actor "Email Service" as email

' --- System Boundary ---
rectangle "E-Commerce System" {

  package "Authentication" {
    usecase "UC-01: Register Account" as UC01
    usecase "UC-02: Login" as UC02
    usecase "UC-03: Forgot Password" as UC03
    usecase "UC-04: Logout" as UC04
  }

  package "Product Management" {
    usecase "UC-05: Browse Products" as UC05
    usecase "UC-06: Search Products" as UC06
    usecase "UC-07: View Product Detail" as UC07
    usecase "UC-08: Manage Categories" as UC08
    usecase "UC-09: Add/Edit Product" as UC09
  }

  package "Order Management" {
    usecase "UC-10: Add to Cart" as UC10
    usecase "UC-11: Checkout" as UC11
    usecase "UC-12: View Order History" as UC12
    usecase "UC-13: Track Order" as UC13
    usecase "UC-14: Cancel Order" as UC14
    usecase "UC-15: Process Order" as UC15
  }

  package "Payment" {
    usecase "UC-16: Make Payment" as UC16
    usecase "UC-17: Process Refund" as UC17
    usecase "UC-18: View Payment History" as UC18
  }

  package "User Management" {
    usecase "UC-19: Manage Users" as UC19
    usecase "UC-20: View Reports" as UC20
    usecase "UC-21: Manage Settings" as UC21
  }

  package "Notifications" {
    usecase "UC-22: Send Order Confirmation" as UC22
    usecase "UC-23: Send Shipping Update" as UC23
  }
}

' --- Customer Relationships ---
customer --> UC01
customer --> UC02
customer --> UC03
customer --> UC05
customer --> UC06
customer --> UC07
customer --> UC10
customer --> UC11
customer --> UC12
customer --> UC13
customer --> UC14
customer --> UC16
customer --> UC18

' --- Staff Relationships ---
staff --> UC02
staff --> UC09
staff --> UC15
staff --> UC17

' --- Admin Relationships ---
admin --> UC02
admin --> UC08
admin --> UC09
admin --> UC19
admin --> UC20
admin --> UC21

' --- System Relationships ---
UC16 ..> payment : <<include>>
UC22 ..> email : <<include>>
UC23 ..> email : <<include>>

' --- Include/Extend ---
UC11 ..> UC10 : <<include>>
UC11 ..> UC16 : <<include>>
UC22 ..> UC11 : <<extend>>
UC04 ..> UC02 : <<extend>>

@enduml
