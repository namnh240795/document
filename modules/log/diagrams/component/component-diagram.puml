@startuml
' ============================================================
' Component Diagram - LOG Module (Simplified)
' ============================================================

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title LOG Module - Component Diagram

' --- External ---
component "AUTH Module" as auth
component "SMS Module" as sms
queue "RabbitMQ" as mq

' --- Service Layer ---
package "Service Layer" {
  component "Log Consumer" as consumer
  component "Log Service" as logSvc
  component "Log Controller" as logCtrl
  component "Log Gateway" as gateway
}

' --- Data Layer ---
package "Data Layer" {
  database "OpenSearch\n(log-events)" as os
}

' --- Relationships ---
auth --> mq
sms --> mq
mq --> consumer
consumer --> logSvc
logSvc --> os
logCtrl --> logSvc
gateway --> logSvc

@enduml
