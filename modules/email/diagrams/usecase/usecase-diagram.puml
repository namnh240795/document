@startuml
' ============================================================
' Use Case Diagram - Email Notification Module
' NestJS + RabbitMQ + SendGrid/SMTP + PostgreSQL
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
}

skinparam nodesep 60
skinparam ranksep 40

' --- Actors ---
actor "AUTH Module" as auth
actor "Email Provider\n(SendGrid/SMTP)" as provider
actor "LOG Module" as log

' --- Use Cases ---
usecase "UC-01: Send Verification\nEmail" as UC01
usecase "UC-02: Resend Verification\nEmail" as UC02
usecase "UC-03: Track Email\nDelivery Status" as UC03
usecase "UC-04: Log Email\nEvents" as UC04
usecase "UC-05: Retry Failed\nEmails" as UC05
usecase "UC-06: Receive Delivery\nCallback" as UC06

' --- AUTH Relationships ---
auth --> UC01
auth --> UC02

' --- Provider Relationships ---
provider --> UC06
UC01 --> provider
UC02 --> provider

' --- LOG Relationships ---
log --> UC04

' --- Include/Extend ---
UC01 ..> UC03 : <<include>>
UC02 ..> UC03 : <<include>>
UC03 ..> UC04 : <<include>>
UC03 ..> UC06 : <<include>>
UC05 ..> UC01 : <<extend>>

@enduml
