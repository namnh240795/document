@startuml
' ============================================================
' ERD - SMS Module
' Database: sms_db
' Resolves: FR-012, FR-013, DR-006
' ============================================================

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}

title SMS Module - Entity Relationship Diagram

package "SMS Module" #E0F7FA {
  entity "sms_logs" as sms_logs {
    * id : uuid <<PK>>
    --
    * user_id : uuid
    * phone : varchar(20)
    * message_type : varchar(50)
    * template_id : varchar(100)
    * status : enum('pending','sent','delivered','failed')
    * provider : varchar(50)
    * provider_message_id : varchar(255)
    * error_message : text
    * retry_count : int DEFAULT 0
    * idempotency_key : varchar(255) <<UNIQUE>>
    * created_at : timestamp
    * sent_at : timestamp
    * delivered_at : timestamp
  }
}

note bottom of sms_logs
  Resolves: DR-006
  FR-012 (Request Verification)
  FR-013 (Resend Verification)

  Cross-database reference:
  user_id references auth_db.auth_users.id
  (application-level, no FK)
end note

@enduml
