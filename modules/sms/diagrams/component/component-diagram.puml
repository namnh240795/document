@startuml
' ============================================================
' Component Diagram - SMS Module (Simplified)
' ============================================================

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title SMS Module - Component Diagram

' --- External ---
queue "RabbitMQ" as mq
component "Twilio" as twilio
component "AUTH Module" as auth

' --- Service Layer ---
package "Service Layer" {
  component "SMS Consumer" as consumer
  component "SMS Service" as smsSvc
  component "SMS Controller" as smsCtrl
}

' --- Data Layer ---
package "Data Layer" {
  database "sms_db\n(PostgreSQL)" as db
}

' --- Relationships ---
auth --> mq
mq --> consumer
consumer --> smsSvc
smsSvc --> twilio
twilio --> smsCtrl
smsCtrl --> smsSvc
smsSvc --> db

@enduml
