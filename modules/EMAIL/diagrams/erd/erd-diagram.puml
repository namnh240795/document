@startuml
' ============================================================
' ERD - Email Notification Module
' Project short name: auth
' NestJS + PostgreSQL + Drizzle ORM
' ============================================================

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Email Notification Module - Entity Relationship Diagram

' ============================================================
' MODULE: Email Notification (Database: email_db)
' Handles: email delivery logs, tracking, audit trail
' Resolves: FR-001, FR-002, FR-003, FR-004, FR-005
' ============================================================
package "Email Notification Module" #E8F4E8 {
  entity "email_logs" as email_logs {
    * id : uuid <<PK>>
    --
    * user_id : uuid
    * email : varchar(255)
    * subject : varchar(500)
    * template_id : varchar(100)
    * status : enum('pending','sent','delivered','failed')
    * provider : varchar(50)
    * provider_message_id : varchar(100)
    * error_message : text
    * retry_count : int DEFAULT 0
    * metadata : jsonb
    * sent_at : timestamp
    * delivered_at : timestamp
    * created_at : timestamp
  }
}

' ============================================================
' MODULE: Authentication (Database: auth_db)
' Referenced via application-level IDs (no FK across databases)
' ============================================================
package "Authentication Module" #E0F7FA {
  entity "auth_users" as users {
    * id : uuid <<PK>>
    --
    * name : varchar(100)
    * email : varchar(255) <<UNIQUE>>
    * ...
  }
}

' ============================================================
' RELATIONSHIPS (application-level, no FK across databases)
' ============================================================

users ||--o{ email_logs : "receives emails"

@enduml
