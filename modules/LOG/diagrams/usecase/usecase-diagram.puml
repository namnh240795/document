@startuml
' ============================================================
' Use Case Diagram - Logger System
' NestJS + RabbitMQ + OpenSearch + PostgreSQL
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
}

' --- Spacing ---
skinparam nodesep 60
skinparam ranksep 40

' --- Actors ---
actor "System\n(Any Service)" as system
actor "Admin" as admin
actor "Logger\nConsumer" as consumer

' --- Force actor order ---
system -[hidden]down- admin
admin -[hidden]down- consumer

' --- Use Cases ---
usecase "UC-01: Publish\nLog Event" as UC01
usecase "UC-02: Consume\n& Index Log" as UC02
usecase "UC-03: Query Logs\n(Search)" as UC03
usecase "UC-04: Get Logs\nby Trace ID" as UC04
usecase "UC-05: Get Logs\nby User ID" as UC05
usecase "UC-06: Get\nError Logs" as UC06
usecase "UC-07: Resolve\nError" as UC07
usecase "UC-08: Log\nRetention Cleanup" as UC08
usecase "UC-09: Health\nCheck" as UC09

' --- System Relationships ---
system --> UC01

' --- Admin Relationships ---
admin --> UC03
admin --> UC04
admin --> UC05
admin --> UC06
admin --> UC07

' --- Consumer Relationships ---
consumer --> UC02

' --- System Automation ---
system --> UC08
system --> UC09

' --- Include/Extend ---
UC01 ..> UC02 : <<include>>
UC03 ..> UC04 : <<extend>>
UC03 ..> UC05 : <<extend>>

@enduml
