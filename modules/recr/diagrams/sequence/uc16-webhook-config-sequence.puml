@startuml
' UC-16: Cấu hình Webhook Cá nhân - Sơ đồ Chuỗi
skinparam dpi 200
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-16: Cấu hình Webhook Cá nhân

actor "Người dùng" as User
participant "RECR Service" as R
database "PostgreSQL" as DB
participant "External URL" as Ext

== Cấu hình Webhook ==

User -> R : PUT /recr/settings/webhook\n{url, events, is_active}
activate R

alt URL không hợp lệ
  R --> User : Lỗi: URL phải HTTPS
else URL hợp lệ
  R -> Ext : POST webhook.test
  activate Ext
  alt Endpoint 2xx
    R -> DB : Lưu cấu hình\n(status: verified)
    activate DB
    DB --> R : OK
    deactivate DB
    R --> User : Thành công\n(Dang hoat dong)
  else Timeout/Lỗi
    R -> DB : Lưu cấu hình\n(status: unverified)
    activate DB
    DB --> R : OK
    deactivate DB
    R --> User : Canh bao\n(chua xac minh)
  end
  deactivate Ext
end
deactivate R

== Xem/Tắt Webhook ==

User -> R : GET /recr/settings/webhook
activate R
R -> DB : Truy van
activate DB
DB --> R : Config
deactivate DB
R --> User : Hiển thị config
deactivate R

@enduml
