@startuml
' UC-16: Cấu hình Webhook Cá nhân - Sơ đồ Chuỗi
skinparam dpi 150
skinparam defaultFontSize 11
skinparam nodesep 15
skinparam ranksep 15
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-16: Cấu hình Webhook Cá nhân

actor "Người dùng" as User
participant "RECR Service" as R
database "PostgreSQL" as DB
participant "Đích Webhook" as Ext

== Cấu hình Webhook ==

User -> R : PUT /recr/settings/webhook\n{url, events, is_active}
activate R

alt URL không hợp lệ
  R --> User : Lỗi: URL phải là HTTPS
else URL hợp lệ
  R -> Ext : POST webhook.test
  activate Ext
  alt Endpoint trả 2xx
    R -> DB : Lưu cấu hình\n(trạng thái: verified)
    activate DB
    DB --> R : Thành công
    deactivate DB
    R --> User : Thành công\n(Đang hoạt động)
  else Timeout/Lỗi
    R -> DB : Lưu cấu hình\n(trạng thái: unverified)
    activate DB
    DB --> R : Thành công
    deactivate DB
    R --> User : Cảnh báo\n(Chưa xác minh)
  end
  deactivate Ext
end
deactivate R

== Xem/Tắt Webhook ==

User -> R : GET /recr/settings/webhook
activate R
R -> DB : Truy vấn cấu hình
activate DB
DB --> R : Dữ liệu cấu hình
deactivate DB
R --> User : Hiển thị cấu hình
deactivate R

@enduml
