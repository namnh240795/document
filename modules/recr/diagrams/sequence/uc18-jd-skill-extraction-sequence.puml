@startuml
' UC-18: Trích xuất Skills từ JD - Sơ đồ Chuỗi
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 15
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-18: Trích xuất Skills từ JD

actor "HR/Employer" as HR
participant "RECR Service" as R
participant "JD Worker" as W
participant "AI Service" as AI
database "DB" as DB

== Lưu nháp JD ==

HR -> R : Lưu nháp JD
activate R
R -> DB : Lưu recr_jobs\n(status: draft)
activate DB
DB --> R : OK
deactivate DB
R -> R : publish job.draft_saved
R --> HR : Đã lưu nháp
deactivate R

== Trích xuất Skills ==

R -> W : consume
activate W
W -> AI : Gọi AI trích xuất
activate AI

alt AI thành công
  AI --> W : JSON skills
  deactivate AI
  W -> DB : Lưu recr_job_skills
  activate DB
  DB --> W : OK
  deactivate DB
  W --> HR : Gợi ý skills
else AI lỗi / JD thiếu
  W --> HR : Cảnh báo, tự nhập
end
deactivate W

== HR chỉnh sửa ==

HR -> R : Cập nhật skills
activate R
R -> DB : UPDATE recr_job_skills
activate DB
DB --> R : OK
deactivate DB
R --> HR : Thành công
deactivate R

@enduml
