@startuml
' UC-18: Trích xuất Skills từ JD - Sơ đồ Chuỗi
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 15
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-18: Trích xuất Skills từ JD

actor "HR/Employer" as HR
participant "RECR Service" as R
participant "JD Worker" as W
participant "AI Service" as AI
database "DB" as DB

== Luu nhap JD ==

HR -> R : Luu nhap JD
activate R
R -> DB : Luu recr_jobs\n(status: draft)
activate DB
DB --> R : OK
deactivate DB
R -> R : publish job.draft_saved
R --> HR : Da luu nhap
deactivate R

== Trích xuất Skills ==

R -> W : consume
activate W
W -> AI : Goi AI trich xuat
activate AI

alt AI thanh cong
  AI --> W : JSON skills
  deactivate AI
  W -> DB : Luu recr_job_skills
  activate DB
  DB --> W : OK
  deactivate DB
  W --> HR : Goi y skills
else AI loi / JD thieu
  W --> HR : Canh bao, tu nhap
end
deactivate W

== HR chinh sua ==

HR -> R : Cap nhat skills
activate R
R -> DB : UPDATE recr_job_skills
activate DB
DB --> R : OK
deactivate DB
R --> HR : Thanh cong
deactivate R

@enduml
