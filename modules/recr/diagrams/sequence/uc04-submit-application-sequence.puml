@startuml
' UC-04: Submit Application - Sequence Diagram
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-04: Submit Application

actor "Candidate" as Cand
participant "Career Portal" as FE
participant "API Gateway" as GW
participant "Recruitment Service" as RS
participant "Notification Service" as NS
database "Recruitment DB" as DB
database "File Storage" as S3

== Step 1: Login & Browse ==

Cand -> FE : Login
activate FE

FE -> GW : POST /auth/login
activate GW
GW --> FE : JWT Token
deactivate GW

Cand -> FE : Browse jobs
FE -> GW : GET /recr/jobs
activate GW
GW --> FE : Job listings
deactivate GW

Cand -> FE : Select job
FE -> GW : GET /recr/jobs/:id
activate GW
GW --> FE : Job details
deactivate GW

== Step 2: Upload Resume ==

Cand -> FE : Upload resume
FE -> S3 : PUT /resumes/{candidate_id}.pdf
activate S3
S3 --> FE : Resume URL
deactivate S3

== Step 3: Submit Application ==

Cand -> FE : Submit application
FE -> GW : POST /recr/applications
activate GW

GW -> RS : Validate & Process
activate RS

RS -> DB : Check duplicate application
activate DB
DB --> RS : No duplicate
deactivate DB

RS -> DB : Create application record
activate DB
DB --> RS : Application created
deactivate DB

== Step 4: Notification ==

RS -> NS : Publish application.submitted
activate NS

NS -> NS : Send confirmation email
NS -> NS : Notify employer
NS --> RS : Done
deactivate NS

== Step 5: Response ==

RS --> GW : 201 Created
deactivate RS

GW --> FE : Application ID
deactivate GW

FE --> Cand : Application submitted
deactivate FE

@enduml
