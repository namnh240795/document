@startuml uc12-review-candidate-sequence
title UC-12: Đánh giá Ứng viên - Sơ đồ Chuỗi
skinparam dpi 200

actor "Phỏng vấn viên" as Interviewer
participant "API Gateway" as API
participant "ReviewController" as Controller
participant "ReviewService" as Service
participant "InterviewRepository" as InterviewRepo
participant "ReviewRepository" as ReviewRepo
database "PostgreSQL" as DB
participant "EventEmitter" as Events

== Xem Phỏng vấn ==
Interviewer -> API : GET /recr/hr/interviews/:id
API -> Controller : getInterview(id)
Controller -> Service : getInterviewById(id)
Service -> InterviewRepo : findById(id)
InterviewRepo -> DB : SELECT * FROM recr_interviews
DB --> InterviewRepo : interview
InterviewRepo --> Service : interview
Service --> Controller : interview
Controller --> API : interview
API --> Interviewer : Chi tiết phỏng vấn

== Nộp Đánh giá ==
Interviewer -> API : POST /recr/hr/reviews/candidates
API -> Controller : createReview(dto, userId)
Controller -> Service : createCandidateReview(dto, userId)

Service -> InterviewRepo : findById(dto.interviewId)
InterviewRepo -> DB : SELECT * FROM recr_interviews
DB --> InterviewRepo : interview
InterviewRepo --> Service : interview

Service -> ReviewRepo : checkExistingReview(dto.interviewId, userId)
ReviewRepo -> DB : SELECT * FROM recr_candidate_reviews WHERE interview_id = ? AND interviewer_id = ?
DB --> ReviewRepo : existing
ReviewRepo --> Service : existing

alt Đã đánh giá trước đó
  Service --> Controller : Lỗi: Đã đánh giá
  Controller --> API : 409 CONFLICT
  API --> Interviewer : Thông báo lỗi
else Phỏng vấn chưa hoàn thành
  Service --> Controller : Lỗi: Phỏng vấn chưa hoàn thành
  Controller --> API : 400 BAD_REQUEST
  API --> Interviewer : Thông báo lỗi
else Đánh giá mới
  Service -> ReviewRepo : create({candidateId, interviewerId, ...dto})
  ReviewRepo -> DB : INSERT INTO recr_candidate_reviews
  DB --> ReviewRepo : review
  ReviewRepo --> Service : review

  Service -> InterviewRepo : updateStatus(dto.interviewId, 'reviewed')
  InterviewRepo -> DB : UPDATE recr_interviews SET status = ?
  DB --> InterviewRepo : updated
  InterviewRepo --> Service : updated

  Service -> Events : emit('review.submitted', {reviewId, type: 'candidate'})
  Events --> Service : ok

  Service --> Controller : review
  Controller --> API : 201 Created
  API --> Interviewer : Đánh giá đã nộp
end

@enduml
