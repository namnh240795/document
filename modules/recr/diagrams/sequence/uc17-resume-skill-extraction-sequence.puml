@startuml
' UC-17: Trích xuất Skills từ CV - Sơ đồ Chuỗi
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 15
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-17: Trích xuất Skills từ CV

actor "Candidate" as C
participant "RECR Service" as R
queue "RabbitMQ" as MQ
participant "Resume Worker" as W
participant "AI Service" as AI
database "DB" as DB

== Tải CV lên ==

C -> R : POST /recr/candidate/resume
activate R
R -> DB : Lưu CV\n(status: pending)
activate DB
DB --> R : OK
deactivate DB
R -> MQ : publish resume.uploaded
R --> C : Thanh cong
deactivate R

== Trích xuất Skills ==

MQ -> W : consume
activate W
W -> W : Doc noi dung CV

alt CV hop le
  W -> AI : Goi AI trich xuat
  activate AI
  AI --> W : JSON skills
  deactivate AI
  W -> DB : Luu recr_resume_skills\n(status: analyzed)
  activate DB
  DB --> W : OK
  deactivate DB
  W --> C : Hien thi skills
else CV khong doc duoc
  W -> DB : status = failed
  activate DB
  DB --> W : OK
  deactivate DB
end
deactivate W

@enduml
