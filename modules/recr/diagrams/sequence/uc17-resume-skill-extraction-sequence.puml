@startuml uc17-resume-skill-extraction-sequence
title UC-17: Trích xuất Skills từ CV bằng AI
skinparam backgroundColor white
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceParticipantPadding 20

actor "Candidate" as C
participant "RECR\nService" as R
participant "Resume\nWorker" as W
participant "AI Service" as AI
database "DB" as DB

== Tải CV lên ==

C -> R : Upload CV
R -> DB : Lưu CV\n(status: pending)
R -> R : publish resume.uploaded
R --> C : Thành công

== Trích xuất Skills (tự động) ==

R -> W : consume\nresume.uploaded
W -> DB : status = processing
W -> W : Đọc nội dung CV\n(PDF/DOCX/OCR)

alt CV không đọc được
  W -> DB : status = failed
  W --> C : Báo Candidate\nnhập tay
else CV hợp lệ
  W -> AI : Gửi nội dung CV\n+ prompt trích xuất
  alt AI lỗi (retry 3 lần)
    W -> DB : status = failed
  else AI thành công
    AI --> W : JSON skills\n+ confidence
    W -> W : Chuẩn hóa tags
    W -> DB : Lưu recr_resume_skills\nstatus = analyzed
    W --> C : Hiển thị skills\ntrên "Hồ sơ của tôi"
  end
end

== Candidate chỉnh sửa Skills ==

C -> R : Cập nhật skill
R -> DB : is_manual_override = true
R --> C : Thành công

@enduml
