@startuml
' UC-16: Post Job - Sequence Diagram
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-16: Post Job

actor "Employer" as Emp
participant "Dashboard" as FE
participant "API Gateway" as GW
participant "Recruitment Service" as RS
participant "Notification Service" as NS
database "Recruitment DB" as DB

== Step 1: Create Job ==

Emp -> FE : Login
activate FE

FE -> GW : POST /auth/login
activate GW
GW --> FE : JWT Token
deactivate GW

Emp -> FE : Create job posting
FE -> GW : POST /recr/employer/jobs
activate GW

GW -> RS : Validate & Process
activate RS

RS -> DB : Create job record (draft)
activate DB
DB --> RS : Job created
deactivate DB

== Step 2: Submit for Approval ==

Emp -> FE : Submit for approval
FE -> GW : PATCH /recr/employer/jobs/:id/submit
activate GW

GW -> RS : Process submission
activate RS

RS -> DB : Update status to "pending_approval"
activate DB
DB --> RS : Status updated
deactivate DB

RS -> NS : Publish job.submitted_for_approval
activate NS
NS -> NS : Notify HR
NS --> RS : Done
deactivate NS

== Step 3: Response ==

RS --> GW : 200 OK
deactivate RS

GW --> FE : Job submitted
deactivate GW

FE --> Emp : Pending approval
deactivate FE

@enduml
