@startuml
' ============================================================
skinparam dpi 200
' Hệ thống Tuyển dụng - Sơ đồ Chuỗi
' Luồng tích hợp cho Ứng viên Nộp hồ sơ
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Luồng Tích hợp: Ứng viên Nộp hồ sơ Việc làm

actor "Ứng viên" as Cand
participant "Cổng việc làm" as FE
participant "API Gateway" as GW
participant "Dịch vụ Tuyển dụng" as RS
participant "Dịch vụ Thông báo" as NS
database "CSDL Tuyển dụng" as DB
database "CSDL Xác thực" as AuthDB

== Bước 1: Đăng nhập & Xem việc ==

Cand -> FE : Đăng nhập
activate FE

FE -> GW : POST /auth/login
activate GW

GW -> AuthDB : Xác minh Thông tin đăng nhập
activate AuthDB
AuthDB --> GW : Token
deactivate AuthDB

GW --> FE : JWT Token
deactivate GW

Cand -> FE : Tìm việc
FE -> GW : GET /recr/jobs
activate GW

GW -> RS : Lấy danh sách Việc làm
activate RS

RS -> DB : Truy vấn Việc làm
activate DB
DB --> RS : Danh sách Việc làm
deactivate DB

RS --> GW : Phản hồi Việc làm
deactivate RS

GW --> FE : Danh sách Việc làm
deactivate GW

FE --> Cand : Hiển thị Việc làm
deactivate FE

== Bước 2: Nộp hồ sơ ==

Cand -> FE : Ứng tuyển Việc làm
activate FE

FE -> GW : POST /recr/applications
activate GW

GW -> RS : Xác thực & Xử lý
activate RS

RS -> AuthDB : Xác minh Ứng viên
activate AuthDB
AuthDB --> RS : Ứng viên hợp lệ
deactivate AuthDB

RS -> DB : Tạo Hồ sơ
activate DB
DB --> RS : Hồ sơ đã tạo
deactivate DB

== Bước 3: Thông báo ==

RS -> NS : Đăng sự kiện Hồ sơ
activate NS

NS -> NS : Gửi email Xác nhận
NS -> NS : Thông báo HR
NS --> RS : Sự kiện đã xử lý
deactivate NS

== Bước 4: Phản hồi ==

RS --> GW : 201 Created
deactivate RS

GW --> FE : Mã Hồ sơ
deactivate GW

FE --> Cand : Hồ sơ đã nộp
deactivate FE

@enduml
