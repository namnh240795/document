@startuml
' UC-20: Gợi ý Ứng viên Phù hợp - Sơ đồ Chuỗi
skinparam dpi 150
skinparam defaultFontSize 11
skinparam nodesep 15
skinparam ranksep 15
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-20: Gợi ý Ứng viên Phù hợp

actor "HR" as HR
participant "RECR Service" as R
queue "RabbitMQ" as MQ
participant "Worker\nGợi ý" as W
database "PostgreSQL" as DB
participant "Thông báo" as N

== Job được duyệt ==

R -> MQ : publish job.approved
activate MQ
MQ -> W : consume
activate W

W -> DB : Lấy recr_job_skills
activate DB
DB --> W : Kỹ năng job
deactivate DB

W -> DB : Lọc ứng viên\n(skill trùng + open_to_work)
activate DB
DB --> W : Danh sách ứng viên
deactivate DB

alt Không có ứng viên
  W --> HR : Không có gợi ý
else Có ứng viên
  W -> W : Tính điểm matching\n(UC-19)
  W -> DB : Lọc ngưỡng >= 70%\n+ Kiểm tra tần suất
  activate DB
  DB --> W : Ứng viên phù hợp
  deactivate DB
  W -> DB : Lưu recr_job_suggestions\n(trạng thái: new)
  activate DB
  DB --> W : Thành công
  deactivate DB
end
deactivate W

MQ -> N : Thông báo HR
activate N
N --> HR : "N ứng viên phù hợp"
deactivate N
deactivate MQ

== HR xem gợi ý ==

HR -> R : GET /recr/hr/jobs/:id/suggestions
activate R
R -> DB : Lấy danh sách gợi ý
activate DB
DB --> R : Dữ liệu
deactivate DB
R --> HR : Danh sách gợi ý
deactivate R

alt HR gửi lời mời
  HR -> R : PATCH trạng thái = contacted
  activate R
  R -> DB : Cập nhật
  activate DB
  DB --> R : Thành công
  deactivate DB
  R --> HR : Thành công
  deactivate R
else HR bỏ qua
  HR -> R : PATCH trạng thái = dismissed
  activate R
  R -> DB : Cập nhật
  activate DB
  DB --> R : Thành công
  deactivate DB
  R --> HR : Thành công
  deactivate R
end

@enduml
