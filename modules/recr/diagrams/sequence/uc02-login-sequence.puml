@startuml
' UC-02: Login - Sequence Diagram
' AUTH handles: credential verification, JWT generation
' RECR handles: role-based redirect
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-02: Login (AUTH + RECR)

actor "User" as User
participant "Frontend" as FE
participant "RECR Service" as RECR
participant "AUTH Service" as AUTH
database "AUTH DB" as ADB

== Step 1: Submit Login ==

User -> FE : Enter credentials (email, password)
activate FE

FE -> RECR : POST /recr/auth/login
activate RECR

== Step 2: AUTH Verifies Credentials ==

RECR -> AUTH : Authenticate (email, password)
activate AUTH

AUTH -> ADB : Find user by email
activate ADB
ADB --> AUTH : User found
deactivate ADB

AUTH -> AUTH : Compare password hash (bcrypt)

AUTH -> ADB : Check account is active
activate ADB
ADB --> AUTH : Account active
deactivate ADB

== Step 3: Generate Token ==

AUTH -> AUTH : Generate JWT token with role claim

AUTH --> RECR : JWT token + role
deactivate AUTH

== Step 4: Response ==

RECR --> FE : 200 OK + JWT + role
deactivate RECR

FE --> User : Redirect to role-based dashboard
deactivate FE

@enduml