@startuml
' UC-05: View Application Status - Sequence Diagram
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-05: View Application Status

actor "Candidate" as Cand
participant "Career Portal" as FE
participant "API Gateway" as GW
participant "Recruitment Service" as RS
database "Recruitment DB" as DB

== Step 1: Load Applications ==

Cand -> FE : Access my applications
activate FE

FE -> GW : GET /recr/candidate/applications
activate GW

GW -> RS : Fetch applications
activate RS

RS -> DB : Query applications
activate DB
DB --> RS : Applications list
deactivate DB

RS --> GW : Applications response
deactivate RS

GW --> FE : Applications
deactivate GW

FE --> Cand : Display applications
deactivate FE

== Step 2: View Details ==

Cand -> FE : Select application
FE -> GW : GET /recr/candidate/applications/:id
activate GW
GW --> FE : Application details
deactivate GW

FE --> Cand : Display details
deactivate FE

@enduml
