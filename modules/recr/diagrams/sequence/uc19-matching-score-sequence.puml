@startuml uc19-matching-score-sequence
title UC-19: Tính điểm Matching Ứng viên - Việc làm
skinparam backgroundColor white
skinparam sequenceArrowThickness 2
skinparam roundcorner 10

actor "Candidate" as C
actor "HR" as HR
participant "RECR\nService" as R
database "DB" as DB

== Xem điểm Matching ==

alt Candidate xem job
  C -> R : GET chi tiết job
else HR xem danh sách ứng viên
  HR -> R : GET danh sách applicants
end

R -> DB : Lấy tags CV\n(recr_resume_skills)
R -> DB : Lấy tags Job\n(recr_job_skills)

alt CV hoặc Job chưa có tag
  R --> C : "Chưa đủ dữ liệu\nde so khớp"
else Đủ dữ liệu
  R -> R : Tính điểm\nrequired=70%\nnice_to_have=20%\nexperience=10%
  R -> DB : Lưu kết quả\nrecr_match_scores
end

R --> C : Điểm % + chi tiết\nmatched/missing skills

alt HR xem danh sách
  R -> R : Sắp xếp applicants\ntheo điểm giảm dần
  R --> HR : Danh sách đã sắp xếp
end

@enduml
