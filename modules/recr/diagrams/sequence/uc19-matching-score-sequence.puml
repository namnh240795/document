@startuml
' UC-19: Tính điểm Matching - Sơ đồ Chuỗi
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 15
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-19: Tính điểm Matching

actor "Candidate" as C
actor "HR" as HR
participant "RECR Service" as R
database "DB" as DB

== Xem điểm Matching ==

alt Candidate xem job
  C -> R : GET chi tiết job
else HR xem danh sách
  HR -> R : GET applicants
end
activate R

R -> DB : Lấy tags CV
activate DB
DB --> R : CV skills
deactivate DB

R -> DB : Lấy tags Job
activate DB
DB --> R : Job skills
deactivate DB

alt Đủ dữ liệu
  R -> R : Tính điểm
  R -> DB : Lưu recr_match_scores
  activate DB
  DB --> R : OK
  deactivate DB
end

R --> C : Điểm % + chi tiết
deactivate R

@enduml
