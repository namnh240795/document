@startuml
' UC-19: Tính điểm Matching - Sơ đồ Chuỗi
skinparam dpi 200
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-19: Tính điểm Matching

actor "Candidate" as C
actor "HR" as HR
participant "RECR Service" as R
database "DB" as DB

== Xem diem Matching ==

alt Candidate xem job
  C -> R : GET chi tiet job
else HR xem danh sach
  HR -> R : GET applicants
end
activate R

R -> DB : Lay tags CV
activate DB
DB --> R : CV skills
deactivate DB

R -> DB : Lay tags Job
activate DB
DB --> R : Job skills
deactivate DB

alt Du du lieu
  R -> R : Tinh diem
  R -> DB : Luu recr_match_scores
  activate DB
  DB --> R : OK
  deactivate DB
end

R --> C : Diem % + chi tiet
deactivate R

@enduml
