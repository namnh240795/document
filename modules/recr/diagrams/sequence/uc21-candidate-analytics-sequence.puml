@startuml
' UC-21: Báo cáo & Thống kê Tương tác Ứng viên - Sơ đồ Chuỗi
skinparam dpi 150
skinparam defaultFontSize 12
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-21: Báo cáo & Thống kê Tương tác Ứng viên

actor "HR / Employer / Admin" as User
participant "RECR Service" as R
database "PostgreSQL" as DB
database "Redis Cache" as Cache
participant "Export Worker" as W

== Truy cập báo cáo ==

User -> R : GET /recr/analytics/candidate-activity\n(filter: time_range, job, department, status)
activate R

R -> Cache : Kiểm tra cache
activate Cache
alt Cache hit
  Cache --> R : Dữ liệu đệm
else Cache miss
  Cache --> R : null
  R -> DB : COUNT candidate_resumes\nWHERE created_at IN range
  activate DB
  DB --> R : CV mới tải lên
  deactivate DB

  R -> DB : COUNT candidate_resumes\nWHERE updated_at > created_at IN range
  activate DB
  DB --> R : CV đã cập nhật
  deactivate DB

  R -> DB : COUNT applications\nWHERE created_at IN range
  activate DB
  DB --> R : Tổng hồ sơ ứng tuyển
  deactivate DB

  R -> DB : COUNT applications\nWHERE status = 'offered'\n/ COUNT all * 100
  activate DB
  DB --> R : Tỷ lệ thành công
  deactivate DB

  R -> Cache : Lưu cache (TTL 5 phút)
  activate Cache
  Cache --> R : OK
  deactivate Cache
end
deactivate Cache

R --> User : JSON response\n{kpi, charts, table}
deactivate R

== Xuất file Excel/CSV ==

User -> R : GET /recr/analytics/export\n(format: xlsx/csv, filter: ...)
activate R

R -> DB : Query toàn bộ dữ liệu
activate DB
DB --> R : Dữ liệu thô
deactivate DB

R -> W : Publish export.requested\n(queue: analytics.export)
activate W
W -> W : Tạo file\n(tối đa 10,000 dòng)
W -> R : Upload file\ntrả về URL tải về
deactivate W

R --> User : { download_url, filename }
deactivate R

User -> User : Tải file

== Thay đổi filter ==

User -> R : GET /recr/analytics/candidate-activity\n(filter: new_time_range)
activate R
R -> Cache : Xóa cache
R -> DB : Query với filter mới
activate DB
DB --> R : Dữ liệu mới
deactivate DB
R --> User : Dữ liệu đã làm mới
deactivate R

== Lỗi tải dữ liệu ==

alt Lỗi database
  R --> User : 500 Internal Error\n"Không thể tải dữ liệu báo cáo"
  User -> R : Thử lại
else Không có dữ liệu
  R --> User : 200 OK\n{ data: [], message: "Không có dữ liệu" }
end

@enduml
