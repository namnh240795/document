@startuml
' UC-01: Register Account - Sequence Diagram
' AUTH handles: user creation, password hashing, role storage, JWT
' RECR handles: profile creation (candidate/employer details)
skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title UC-01: Register Account (AUTH + RECR)

actor "User" as User
participant "Frontend" as FE
participant "RECR Service" as RECR
participant "AUTH Service" as AUTH
database "RECR DB" as RDB
database "AUTH DB" as ADB
queue "Event Bus" as MQ

== Step 1: Submit Registration ==

User -> FE : Enter registration details (email, password, name, role)
activate FE

FE -> RECR : POST /recr/auth/register
activate RECR

== Step 2: AUTH Creates User Account with Role ==

RECR -> AUTH : Create user (email, password, name, <b>role</b>)
activate AUTH

AUTH -> ADB : Check email availability
activate ADB
ADB --> AUTH : Email available
deactivate ADB

AUTH -> AUTH : Hash password (bcrypt)

AUTH -> ADB : Create user record <b>with role</b>
activate ADB
ADB --> AUTH : User created (user_id, role)
deactivate ADB

AUTH -> AUTH : Generate JWT token <b>with role claim</b>

AUTH --> RECR : user_id + JWT token (contains role)
deactivate AUTH

== Step 3: RECR Creates Profile ==

RECR -> RDB : Create profile (candidate/employer details)
activate RDB
RDB --> RECR : Profile created
deactivate RDB

== Step 4: Notification ==

RECR -> MQ : Publish user.registered event
activate MQ
MQ --> RECR : Ack
deactivate MQ

== Step 5: Response ==

RECR --> FE : 201 Created + JWT
deactivate RECR

FE --> User : Redirect to Dashboard
deactivate FE

@enduml