@startuml
' ============================================================
' Hệ thống Tuyển dụng - Tổng quan Kiến trúc (C4 Level 1)
' Ngữ cảnh hệ thống cấp cao
' ============================================================

skinparam actor {
  BackgroundColor #F8F8F8
  BorderColor #333333
}
skinparam component {
  BackgroundColor #F8F8F8
  BorderColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}
skinparam cloud {
  BackgroundColor #E8E8FD
  BorderColor #333333
}

title Hệ thống Tuyển dụng - Sơ đồ Ngữ cảnh Hệ thống (C4 Level 1)

' --- Người ---
actor "Ứng viên" as candidate
actor "Nhà tuyển dụng" as recruiter
actor "Quản lý HR" as hr
actor "Phỏng vấn viên" as interviewer

' --- Hệ thống của chúng tôi ---
cloud "Nền tảng Tuyển dụng" as system {
  package "Frontend" {
    [Cổng việc làm] as portal
    [Bảng điều khiển Tuyển dụng] as dashboard
  }

  package "Dịch vụ Backend" {
    [API Gateway] as gw
    [Lõi Tuyển dụng] as core
  }

  package "Dữ liệu & Hạ tầng" {
    database "CSDL Chính" as db
    database "Tầng Bộ nhớ đệm" as cache
    queue "Bus Sự kiện" as mq
    [Công cụ Tìm kiếm] as search
  }
}

' --- Hệ thống bên ngoài ---
cloud "Nhà cung cấp Email\n(SendGrid)" as email
cloud "Dịch vụ Lịch\n(Google/Outlook)" as calendar
cloud "Trình phân tích CV\n(Dịch vụ AI)" as parser
cloud "Giám sát\n(Datadog)" as monitoring
cloud "Hệ thống HR\n(Hiện có)" as hrSystem

' --- Quan hệ ---
candidate --> portal
recruiter --> dashboard
hr --> dashboard
interviewer --> dashboard

portal --> gw
dashboard --> gw

gw --> core

core --> db
core --> cache
core --> mq
core --> search

core ..> email : <<HTTPS>>
core ..> calendar : <<API>>
core ..> parser : <<API>>
core ..> hrSystem : <<Tích hợp>>

core --> monitoring : metrics/logs

note bottom of system
  C4 Level 1: Ngữ cảnh Hệ thống
  Hiển thị các actor và tương tác hệ thống bên ngoài
end note

@enduml
