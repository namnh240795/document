@startuml
' ============================================================
' Hệ thống Tuyển dụng - Sơ đồ Hoạt động
' Quy trình cho 3 vai trò: Ứng viên, HR, Nhà tuyển dụng
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quy trình Tuyển dụng (3 Vai trò)

|Hệ thống|
start
:Người dùng truy cập Hệ thống;

if (Đăng nhập với vai trò?) then (Ứng viên)
  |Ứng viên|
  :Xem danh sách Việc làm;

  :Chọn vị trí Việc làm;

  :Nộp hồ sơ;

  |Hệ thống|
  :Xác thực Hồ sơ;

  if (Hồ sơ hợp lệ?) then (có)
    :Tạo bản ghi Hồ sơ;

    :Thông báo HR;

    |HR|
    :Xem Hồ sơ;

    if (Ứng viên đạt yêu cầu?) then (có)
      :Lên lịch Phỏng vấn;

      |Ứng viên|
      :Tham gia Phỏng vấn;

      |HR|
      :Đánh giá Phỏng vấn;

      if (Đánh giá tích cực?) then (có)
        :Tạo Đề nghị;

        |Nhà tuyển dụng|
        :Phê duyệt Đề nghị;

        if (Đề nghị được duyệt?) then (có)
          :Gửi Thư đề nghị;

          |Ứng viên|
          if (Chấp nhận Đề nghị?) then (có)
            :Cập nhật trạng thái là Đã tuyển;

            |Hệ thống|
            :Tạo bản ghi Nhân viên;

          else (không)
            :Thông báo HR;
          endif

        else (không)
          :Thông báo HR;
        endif

      else (không)
        :Từ chối Ứng viên;

        |Hệ thống|
        :Gửi email Từ chối;
      endif

    else (không)
      :Từ chối Ứng viên;

      |Hệ thống|
      :Gửi email Từ chối;
    endif

  else (không)
    :Trả về lỗi;
  endif

elseif (Nhà tuyển dụng)
  |Nhà tuyển dụng|
  :Tạo Tin tuyển dụng;

  :Gửi để Phê duyệt;

  |HR|
  :Xem Tin tuyển dụng;

  if (Được phê duyệt?) then (có)
    :Phê duyệt Việc làm;

    |Hệ thống|
    :Đăng Tin tuyển dụng;

    :Thông báo Nhà tuyển dụng;

  else (không)
    :Trả về để Sửa đổi;

    |Nhà tuyển dụng|
    :Sửa đổi Tin tuyển dụng;
  endif

elseif (HR)
  |HR|
  :Truy cập Bảng điều khiển;

  :Xem Quy trình;

  :Xem Hồ sơ;

  :Lên lịch Phỏng vấn;

  :Quản lý Đề nghị;

  :Tạo Báo cáo;

endif

stop

@enduml
