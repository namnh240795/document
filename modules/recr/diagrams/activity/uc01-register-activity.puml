@startuml
' UC-01: Register Account - Activity Diagram
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-01: Register Account (Candidate/Employer)

start
:Access Registration Page;

:Enter Email & Password;

:Enter Full Name & Phone;

:Select Role (Candidate/Employer);

if (Role = Employer?) then (yes)
  :Enter Company Name;
  :Enter Industry & Company Size;
endif

:Submit Registration;

:Validate Input Data;

if (Valid Input?) then (yes)
  :Check Email Availability;

  if (Email Available?) then (yes)
    :Hash Password;

    :Create User Record;

    if (Role = Candidate?) then (yes)
      :Create Candidate Profile;
    else (no)
      :Create Employer Profile;
    endif

    :Generate JWT Token;

    :Return Success Response;

    :Redirect to Dashboard;

  else (no)
    :Return Error "Email exists";

    :Show Error Message;
  endif

else (no)
  :Return Validation Error;

  :Show Error Details;
endif

stop
@enduml
