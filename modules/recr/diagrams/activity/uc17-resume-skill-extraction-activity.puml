@startuml
' UC-17: Trích xuất Skills từ CV - Sơ đồ Hoạt động
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 15
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-17: Trích xuất Skills từ CV bằng AI

start

:Nhận resume.uploaded;

:Đưa vào hàng đợi;

if (CV đọc được?) then (không)
  :Trạng thái: failed;
  stop
endif

:Trích xuất văn bản\n(PDF/DOCX/OCR);

:Gọi AI trích xuất skills;

if (AI lỗi?) then (có)
  :Retry 3 lần;
  if (Vẫn lỗi?) then (có)
    :Trạng thái: failed;
    stop
  endif
endif

:Chuẩn hóa tags;

:Lưu recr_resume_skills;

:Candidate xem skills;

stop

@enduml
