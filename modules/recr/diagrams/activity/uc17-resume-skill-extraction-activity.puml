@startuml
' UC-17: Trích xuất Skills từ CV - Sơ đồ Hoạt động
skinparam dpi 200
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-17: Trích xuất Skills từ CV bằng AI

start

:Nhận resume.uploaded;

:Đưa vào hàng đợi;

if (CV đọc được?) then (có)
  :Trích xuất văn bản (PDF/DOCX/OCR);
else (không)
  :Trạng thái: failed;
endif

if (AI lỗi?) then (không)
  :Chuẩn hóa tags;
  :Lưu recr_resume_skills;
  :Candidate xem skills;
else (có)
  :Retry 3 lần;
  if (Vẫn lỗi?) then (có)
    :Trạng thái: failed;
  else (không)
    :Chuẩn hóa tags;
    :Lưu recr_resume_skills;
    :Candidate xem skills;
  endif
endif

stop

@enduml
