@startuml
' UC-05: View Application Status - Activity Diagram
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-05: View Application Status (Candidate)

start
:Login as Candidate;

:Access My Applications;

:Query Applications;

:Return Applications List;

:View Application List;

:Select Application;

:View Application Details;

:View Current Status;

:View Status History;

if (Status = Interview?) then (yes)
  :View Interview Details;

  :View Date & Location;

elseif (Status = Offer?) then (yes)
  :View Offer Details;

  :View Salary & Benefits;

  :Accept/Reject Offer;

elseif (Status = Rejected?) then (yes)
  :View Rejection Reason;

else (no)
  :View Application Timeline;
endif

stop
@enduml
