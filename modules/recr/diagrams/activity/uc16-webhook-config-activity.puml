@startuml
' UC-16: Cấu hình Webhook Cá nhân - Sơ đồ Hoạt động
skinparam dpi 200
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-16: Cấu hình Webhook Cá nhân

start

:Truy cập Cài đặt > Webhook;

:Nhập URL webhook;

:Chọn sự kiện\n(application.submitted);

:Bật "Kích hoạt Webhook";

if (URL hợp lệ HTTPS?) then (không)
  :Lỗi xác thực URL;
  stop
endif

:Gửi webhook.test;

if (Endpoint 2xx?) then (không)
  :Trạng thái: Chưa xác minh;
  stop
endif

:Lưu cấu hình webhook;

:Thành công - Đang hoạt động;

stop

@enduml
