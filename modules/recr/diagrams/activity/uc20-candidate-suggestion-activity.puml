@startuml
' UC-20: Gợi ý Ứng viên Phù hợp - Sơ đồ Hoạt động
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 15
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-20: Gợi ý Ứng viên Phù hợp

start

:Nhan su kien job.approved;

:Lay danh sach skill\ntu recr_job_skills;

:Loc so bo ung vien\n(skill trung + is_open_to_work\n+ chua hired trong to chuc);

if (Co ung vien?) then (khong)
  :Khong tao goi y;
  stop
endif

:Tinh diem matching\n(tai su dung UC-19);

:Loc nguong >= 70%;

if (Co ung vien dat nguong?) then (khong)
  :Ghi log, khong thong bao;
  stop
endif

:Kiem tra gioi han tan suat\n(3 loi moi/tuan/to chuc);

:Luu recr_job_suggestions\n(status: new);

:Thong bao cho HR\n"N ung vien phu hop";

:HR xem danh sach goi y;

if (HR hanh dong?) then (gui loi moi)
  :Cap nhat status = contacted;
else (bo qua)
  :Cap nhat status = dismissed;
endif

stop

@enduml
