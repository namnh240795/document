@startuml
' UC-20: Gợi ý Ứng viên Phù hợp - Sơ đồ Hoạt động
skinparam dpi 200
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-20: Gợi ý Ứng viên Phù hợp

start

:Nhận sự kiện job.approved;

:Lấy danh sách skill từ recr_job_skills;

:Lọc sơ bộ ứng viên (skill trùng + is_open_to_work + chưa hired trong tổ chức);

if (Có ứng viên?) then (có)
  :Tính điểm matching (tái sử dụng UC-19);
  :Lọc ngưỡng >= 70%;
else (không)
  :Không tạo gợi ý;
endif

if (Có ứng viên đạt ngưỡng?) then (có)
  :Kiểm tra giới hạn tần suất (3 lời mời/tuần/tổ chức);
  :Lưu recr_job_suggestions (status: new);
  :Thông báo cho HR "N ứng viên phù hợp";
  :HR xem danh sách gợi ý;
else (không)
  :Ghi log, không thông báo;
endif

if (HR hành động?) then (gửi lời mời)
  :Cập nhật status = contacted;
else (bỏ qua)
  :Cập nhật status = dismissed;
endif

stop

@enduml
