@startuml
' UC-12: Gửi đề nghị - Sơ đồ Hoạt động
skinparam dpi 200
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-12: Gửi đề nghị (HR)

start
:Đăng nhập với tư cách HR;

:Truy cập Hồ sơ Ứng viên;

:Xem Điểm đánh giá;

:Xem Phản hồi Phỏng vấn;

:Tạo Thư đề nghị;

:Nhập Lương & Phúc lợi;

:Nhập Ngày bắt đầu;

:Xem Chi tiết Đề nghị;

:Gửi Đề nghị;

:Xác thực Đề nghị;

if (Đề nghị hợp lệ?) then (có)
  :Tạo bản ghi Đề nghị;

  :Cập nhật Trạng thái Hồ sơ;

  :Tạo Tài liệu Đề nghị;

  :Gửi email Đề nghị cho Ứng viên;

  :Hiển thị thông báo Thành công;

  :Theo dõi Trạng thái Đề nghị;

else (không)
  :Trả về lỗi Xác thực;

  :Hiển thị Chi tiết lỗi;
endif

stop
@enduml
