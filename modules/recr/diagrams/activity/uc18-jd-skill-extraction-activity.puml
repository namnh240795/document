@startuml
' UC-18: Trích xuất Skills từ JD - Sơ đồ Hoạt động
skinparam dpi 200
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-18: Trích xuất Skills từ JD bằng AI

start

:Lưu nháp tin tuyển dụng;

if (HR bấm "Gợi ý Tags AI?" ) then (có)
  :Gửi job vào hàng đợi;
else (tự động)
  :Hệ thống tự động gửi;
endif

:Gọi AI với nội dung JD;

if (AI lỗi / JD thiếu info?) then (không)
  :Chuẩn hóa tags;
  :Lưu recr_job_skills;
  :Hiển thị gợi ý cho HR;
  :HR xác nhận / chỉnh sửa;
else (có)
  :HR tự nhập tag thủ công;
endif

:Tiếp tục luồng gửi duyệt;

stop

@enduml
