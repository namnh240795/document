@startuml
' UC-14: Review Candidate - Activity Diagram
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-14: Review Candidate (Interviewer)

start
:Navigate to Completed Interview;

:Click "Write Review";

:Check if Interview is Completed;

if (Interview Completed?) then (yes)
  :Display Review Form;

  :Rate Candidate (1-5 Stars);
  note right
    - Technical Skills
    - Communication Skills
    - Cultural Fit
    - Problem-Solving
    - Team Collaboration
  end note

  :Write Review Title;

  :Write Review Description;

  :Select Recommendation;
  note right
    - strong_yes
    - yes
    - neutral
    - no
    - strong_no
  end note

  :Submit Review;

  :Validate Review Data;

  if (Already Reviewed?) then (yes)
    :Show "Already Reviewed" Message;

  else (no)
    :Save Review Record;

    :Update Candidate Average Rating;

    :Return Success Response;

    :Show Confirmation;

  endif

else (no)
  :Show "Interview Must Be Completed First" Message;

endif

stop
@enduml
