@startuml
' UC-04: Submit Application - Activity Diagram
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-04: Submit Application (Candidate)

start
:Login as Candidate;

:Browse Job Listings;

:Select Job Position;

:View Job Details;

:Click Apply;

:Upload Resume (PDF/DOCX);

:Enter Cover Letter;

:Review Application;

:Submit Application;

:Validate Application;

if (Valid Application?) then (yes)
  :Check Duplicate Application;

  if (Already Applied?) then (no)
    :Create Application Record;

    :Update Job Application Count;

    :Notify Employer;

    :Show Success Message;

    :View Application Status;

  else (yes)
    :Show "Already Applied" Error;
  endif

else (no)
  :Return Validation Error;

  :Show Error Details;
endif

stop
@enduml
