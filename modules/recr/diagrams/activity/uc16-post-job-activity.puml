@startuml
' UC-16: Post Job - Activity Diagram
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-16: Post Job (Employer)

start
:Login as Employer;

:Access Job Management;

:Click "Create New Job";

:Enter Job Title;

:Enter Job Description;

:Select Department;

:Enter Location;

:Enter Salary Range;

:Select Employment Type;

:Add Job Requirements;

:Save as Draft;

:Validate Job Data;

if (Valid Job?) then (yes)
  :Create Job Record (Draft);

  :Notify Employer;

  :Review Job Posting;

  :Submit for HR Approval;

  :Update Status to "Pending";

  :Notify HR;

  :Review Job Posting;

  if (Approved?) then (yes)
    :Approve Job;

    :Update Status to "Open";

    :Publish Job Listing;

  else (no)
    :Return for Revision;

    :Revise Job Posting;
  endif

else (no)
  :Return Validation Error;

  :Show Error Details;
endif

stop
@enduml
