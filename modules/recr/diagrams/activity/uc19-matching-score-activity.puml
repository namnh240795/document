@startuml
' UC-19: Tính điểm Matching - Sơ đồ Hoạt động
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 15
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-19: Tính điểm Matching

start

:Xem chi tiết job / danh sách ứng viên;

:Lấy tags CV;

if (CV có tag?) then (không)
  :Điểm = 0%\n"Chưa đủ dữ liệu";
  stop
endif

:Lấy tags Job;

if (Job có tag?) then (không)
  :Điểm = 0%\n"Chưa đủ dữ liệu";
  stop
endif

if (Đang processing?) then (có)
  :Đang tính toán...;
  stop
endif

:Tính điểm\n(required=70%\nnice_to_have=20%\nexperience=10%);

:Lưu recr_match_scores;

:Hiển thị điểm % + chi tiết;

if (HR xem?) then (có)
  :Sắp xếp theo điểm giảm dần;
endif

stop

@enduml
