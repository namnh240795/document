@startuml
' UC-19: Tính điểm Matching - Sơ đồ Hoạt động
skinparam dpi 150
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 15
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-19: Tính điểm Matching

start

:Xem chi tiet job / danh sach ung vien;

:Lay tags CV;

if (CV co tag?) then (khong)
  :Diem = 0%\n"Chua du du lieu";
  stop
endif

:Lay tags Job;

if (Job co tag?) then (khong)
  :Diem = 0%\n"Chua du du lieu";
  stop
endif

if (Dang processing?) then (co)
  :Dang tinh toan...;
  stop
endif

:Tinh diem\n(required=70%\nnice_to_have=20%\nexperience=10%);

:Luu recr_match_scores;

:Hien thi diem % + chi tiet;

if (HR xem?) then (co)
  :Sap xep theo diem giam dan;
endif

stop

@enduml
