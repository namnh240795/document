@startuml
' UC-19: Tính điểm Matching - Sơ đồ Hoạt động
skinparam dpi 200
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title UC-19: Tính điểm Matching

start

:Xem chi tiết job / danh sách ứng viên;

:Lấy tags CV;

if (CV có tag?) then (có)
  :Lấy tags Job;
else (không)
  :Điểm = 0% "Chưa đủ dữ liệu";
endif

if (Job có tag?) then (có)
  if (Đang processing?) then (không)
    :Tính điểm (required=70% nice_to_have=20% experience=10%);
    :Lưu recr_match_scores;
    :Hiển thị điểm % + chi tiết;
  else (có)
    :Đang tính toán...;
  endif
else (không)
  :Điểm = 0% "Chưa đủ dữ liệu";
endif

if (HR xem?) then (có)
  :Sắp xếp theo điểm giảm dần;
endif

stop

@enduml
