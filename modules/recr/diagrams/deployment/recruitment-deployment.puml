@startuml
' ============================================================
' Hệ thống Tuyển dụng - Sơ đồ Triển khai
' Topology hạ tầng
' ============================================================

skinparam node {
  BackgroundColor #E8F4E8
  BorderColor #333333
}
skinparam artifact {
  BackgroundColor #F8F8F8
  BorderColor #333333
}
skinparam database {
  BackgroundColor #FDE8E8
  BorderColor #333333
}
skinparam cloud {
  BackgroundColor #E8E8FD
  BorderColor #333333
}

title Hệ thống Tuyển dụng - Sơ đồ Triển khai

' --- CDN / Edge ---
cloud "CDN\n(CloudFront)" as cdn

' --- Bộ cân tải ---
node "Bộ cân tải\n(ALB)" as alb

' --- Máy chủ Ứng dụng ---
node "Máy chủ Ứng dụng 1\n(EC2 / ECS)" as app1 {
  artifact "API Gateway\n(Node.js)" as api1
  artifact "Dịch vụ Tuyển dụng\n(Node.js)" as recr1
  artifact "Dịch vụ Xác thực\n(Node.js)" as auth1
}

node "Máy chủ Ứng dụng 2\n(EC2 / ECS)" as app2 {
  artifact "API Gateway\n(Node.js)" as api2
  artifact "Dịch vụ Tuyển dụng\n(Node.js)" as recr2
  artifact "Dịch vụ Xác thực\n(Node.js)" as auth2
}

' --- Máy chủ Worker ---
node "Máy chủ Worker\n(EC2)" as worker {
  artifact "Worker Thông báo\n(Node.js)" as workerNotif
  artifact "Trình phân tích CV\n(Node.js)" as workerParser
}

' --- Tầng Dữ liệu ---
node "CSDL Chính\n(RDS PostgreSQL)" as dbPrimary {
  database "recr_db\n(recr_*)" as recrData
  database "auth_db\n(auth_*)" as authData
}

node "Replica Đọc\n(RDS PostgreSQL)" as dbReplica {
  database "recr_db (đọc)" as recrRead
}

node "Bộ nhớ đệm\n(ElastiCache Redis)" as redis

node "Hàng đợi Thông báo\n(RabbitMQ)" as mq

' --- Tìm kiếm ---
node "Công cụ Tìm kiếm\n(OpenSearch)" as search

' --- Bên ngoài ---
cloud "API Bên ngoài" as external

' --- Quan hệ ---
cdn --> alb : HTTPS
alb --> app1 : HTTP
alb --> app2 : HTTP

app1 --> dbPrimary : TCP 5432
app2 --> dbPrimary : TCP 5432

dbPrimary --> dbReplica : sao chép

app1 --> redis : TCP 6379
app2 --> redis : TCP 6379

app1 --> search : TCP 9200
app2 --> search : TCP 9200

app1 --> mq : TCP 5672
app2 --> mq : TCP 5672

mq --> worker : tiêu thụ

worker --> dbPrimary : TCP 5432
workerNotif --> external : HTTPS
workerParser --> external : HTTPS

app1 --> external : HTTPS
app2 --> external : HTTPS

@enduml
