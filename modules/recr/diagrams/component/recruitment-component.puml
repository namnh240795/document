@startuml
' ============================================================
' Hệ thống Tuyển dụng - Sơ đồ Thành phần
' Kiến trúc hệ thống
' ============================================================

skinparam component {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  InterfaceBackgroundColor #FFFFFF
  InterfaceBorderColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Hệ thống Tuyển dụng - Sơ đồ Thành phần

' --- Người dùng bên ngoài ---
actor "Ứng viên" as candidate
actor "Nhà tuyển dụng" as recruiter
actor "Quản lý HR" as hr
actor "Phỏng vấn viên" as interviewer

' --- Tầng Client ---
package "Tầng Client" {
  [Cổng việc làm] as portal
  [Bảng điều khiển Tuyển dụng] as dashboard
  [Cổng Phỏng vấn viên] as interviewPortal
}

' --- Tầng API ---
package "Tầng API" {
  [API Gateway] as gw
  [Bộ cân tải] as lb
}

' --- Tầng Dịch vụ ---
package "Tầng Dịch vụ" {
  [Dịch vụ Xác thực] as auth
  [Dịch vụ Tuyển dụng] as recr
  [Dịch vụ Việc làm] as job
  [Dịch vụ Ứng viên] as candidateSvc
  [Dịch vụ Phỏng vấn] as interview
  [Dịch vụ Đề nghị] as offer
  [Dịch vụ Thông báo] as notif
}

' --- Tầng Dữ liệu ---
package "Tầng Dữ liệu" {
  database "CSDL Tuyển dụng\n(PostgreSQL)" as recrDB
  database "CSDL Xác thực\n(PostgreSQL)" as authDB
  database "Bộ nhớ đệm\n(Redis)" as cache
  queue "Hàng đợi Thông báo\n(RabbitMQ)" as mq
  [Công cụ Tìm kiếm\n(Elasticsearch)] as search
}

' --- Dịch vụ Bên ngoài ---
package "Dịch vụ Bên ngoài" {
  [Dịch vụ Email\n(SendGrid)] as email
  [Dịch vụ SMS] as sms
  [Tích hợp Lịch\n(Google/Outlook)] as calendar
  [Trình phân tích CV] as parser
}

' --- Quan hệ ---
candidate --> portal
recruiter --> dashboard
hr --> dashboard
interviewer --> interviewPortal

portal --> lb
dashboard --> lb
interviewPortal --> lb
lb --> gw

gw --> auth
gw --> recr
gw --> job
gw --> candidateSvc
gw --> interview
gw --> offer

auth --> authDB
auth --> cache

recr --> recrDB
recr --> cache
recr --> search

job --> recrDB
job --> search

candidateSvc --> recrDB
candidateSvc --> parser

interview --> recrDB
interview --> calendar

offer --> recrDB
offer --> mq

mq --> notif

notif --> email
notif --> sms

recr ..> auth : <<REST>>

@enduml
