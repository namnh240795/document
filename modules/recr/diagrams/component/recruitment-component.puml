@startuml
' ============================================================
' Recruitment System - Component Diagram
' System architecture
' ============================================================

skinparam component {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  InterfaceBackgroundColor #FFFFFF
  InterfaceBorderColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Recruitment System - Component Diagram

' --- External Users ---
actor "Candidate" as candidate
actor "Recruiter" as recruiter
actor "HR Manager" as hr
actor "Interviewer" as interviewer

' --- Client Layer ---
package "Client Layer" {
  [Career Portal] as portal
  [Recruitment Dashboard] as dashboard
  [Interviewer Portal] as interviewPortal
}

' --- API Layer ---
package "API Layer" {
  [API Gateway] as gw
  [Load Balancer] as lb
}

' --- Service Layer ---
package "Service Layer" {
  [Auth Service] as auth
  [Recruitment Service] as recr
  [Job Service] as job
  [Candidate Service] as candidateSvc
  [Interview Service] as interview
  [Offer Service] as offer
  [Notification Service] as notif
}

' --- Data Layer ---
package "Data Layer" {
  database "Recruitment DB\n(PostgreSQL)" as recrDB
  database "Auth DB\n(PostgreSQL)" as authDB
  database "Cache\n(Redis)" as cache
  queue "Message Queue\n(RabbitMQ)" as mq
  [Search Engine\n(Elasticsearch)] as search
}

' --- External Services ---
package "External Services" {
  [Email Service\n(SendGrid)] as email
  [SMS Service] as sms
  [Calendar Integration\n(Google/Outlook)] as calendar
  [Resume Parser] as parser
}

' --- Relationships ---
candidate --> portal
recruiter --> dashboard
hr --> dashboard
interviewer --> interviewPortal

portal --> lb
dashboard --> lb
interviewPortal --> lb
lb --> gw

gw --> auth
gw --> recr
gw --> job
gw --> candidateSvc
gw --> interview
gw --> offer

auth --> authDB
auth --> cache

recr --> recrDB
recr --> cache
recr --> search

job --> recrDB
job --> search

candidateSvc --> recrDB
candidateSvc --> parser

interview --> recrDB
interview --> calendar

offer --> recrDB
offer --> mq

mq --> notif

notif --> email
notif --> sms

recr ..> auth : <<REST>>

@enduml
