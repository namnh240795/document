@startuml
' ============================================================
' Module Tuyển dụng - Sơ đồ Quan hệ Thực thể
' Tất cả các bảng: recr_<tên_bảng>
' Vai trò: Ứng viên, HR, Nhà tuyển dụng
' ============================================================

skinparam class {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 12
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Hệ thống Tuyển dụng - Sơ đồ Quan hệ Thực thể

' ============================================================
' MODULE: Tuyển dụng - Người dùng & Xác thực
' Xử lý: tài khoản ứng viên, tài khoản nhà tuyển dụng, tài khoản HR
' Giải quyết: FR-001, FR-002, FR-003
' ============================================================
package "Người dùng Tuyển dụng" #E8F4E8 {
  entity "recr_users" as users {
    * id : bigint <<PK>>
    --
    * user_id : bigint <<FK>> <<UNIQUE>>
    * avatar_url : varchar(500)
    * created_at : timestamp
    * updated_at : timestamp
  }

  entity "recr_candidates" as candidates {
    * id : bigint <<PK>>
    --
    * user_id : bigint <<FK>> <<UNIQUE>>
    * resume_url : varchar(500)
    * linkedin_url : varchar(300)
    * skills : jsonb
    * experience_years : int
    * current_company : varchar(200)
    * expected_salary : decimal(12,2)
    * source : enum('website','referral','linkedin','job_board','other')
    * created_at : timestamp
    * updated_at : timestamp
  }

  entity "recr_employers" as employers {
    * id : bigint <<PK>>
    --
    * user_id : bigint <<FK>> <<UNIQUE>>
    * company_name : varchar(200)
    * company_website : varchar(300)
    * company_description : text
    * industry : varchar(100)
    * company_size : enum('1-10','11-50','51-200','201-500','501-1000','1000+')
    * logo_url : varchar(500)
    * is_verified : boolean
    * created_at : timestamp
    * updated_at : timestamp
  }

  entity "recr_hr_profiles" as hr_profiles {
    * id : bigint <<PK>>
    --
    * user_id : bigint <<FK>> <<UNIQUE>>
    * department : varchar(100)
    * position : varchar(100)
    * created_at : timestamp
  }
}

' ============================================================
' MODULE: Tuyển dụng - Việc làm
' Xử lý: tin tuyển dụng, yêu cầu
' Giải quyết: FR-004, FR-005, FR-006
' ============================================================
package "Việc làm Tuyển dụng" #E8E8FD {
  entity "recr_jobs" as jobs {
    * id : bigint <<PK>>
    --
    * employer_id : bigint <<FK>>
    * title : varchar(200)
    * description : text
    * department : varchar(100)
    * location : varchar(200)
    * salary_min : decimal(12,2)
    * salary_max : decimal(12,2)
    * employment_type : enum('full_time','part_time','contract','internship')
    * status : enum('draft','pending_approval','open','closed','archived')
    * approved_by : bigint <<FK>>
    * approved_at : timestamp
    * created_at : timestamp
    * updated_at : timestamp
  }

  entity "recr_job_requirements" as job_requirements {
    * id : bigint <<PK>>
    --
    * job_id : bigint <<FK>>
    * requirement_type : enum('skill','experience','education','certification')
    * description : text
    * is_mandatory : boolean
    * sort_order : int
  }
}

' ============================================================
' MODULE: Tuyển dụng - Hồ sơ
' Xử lý: đơn ứng tuyển
' Giải quyết: FR-007, FR-008, FR-009
' ============================================================
package "Hồ sơ Tuyển dụng" #FDE8E8 {
  entity "recr_applications" as applications {
    * id : bigint <<PK>>
    --
    * job_id : bigint <<FK>>
    * candidate_id : bigint <<FK>>
    * cover_letter : text
    * status : enum('submitted','screening','interview','offer','rejected','hired')
    * applied_at : timestamp
    * updated_at : timestamp
  }
}

' ============================================================
' MODULE: Tuyển dụng - Phỏng vấn
' Xử lý: lịch phỏng vấn và đánh giá
' Giải quyết: FR-010, FR-011, FR-012
' ============================================================
package "Phỏng vấn Tuyển dụng" #FFF3E0 {
  entity "recr_interviews" as interviews {
    * id : bigint <<PK>>
    --
    * application_id : bigint <<FK>>
    * interviewer_id : bigint <<FK>>
    * scheduled_at : timestamp
    * duration_minutes : int
    * location : varchar(200)
    * meeting_link : varchar(500)
    * status : enum('scheduled','completed','cancelled','no_show')
    * notes : text
    * created_at : timestamp
  }

  entity "recr_evaluations" as evaluations {
    * id : bigint <<PK>>
    --
    * interview_id : bigint <<FK>>
    * evaluator_id : bigint <<FK>>
    * score : int
    * technical_score : int
    * communication_score : int
    * cultural_fit_score : int
    * recommendation : enum('strong_yes','yes','neutral','no','strong_no')
    * comments : text
    * submitted_at : timestamp
  }
}

' ============================================================
' MODULE: Tuyển dụng - Đề nghị
' Xử lý: đề nghị việc làm
' Giải quyết: FR-013, FR-014
' ============================================================
package "Đề nghị Tuyển dụng" #E0F7FA {
  entity "recr_offers" as offers {
    * id : bigint <<PK>>
    --
    * application_id : bigint <<FK>>
    * salary : decimal(12,2)
    * position_title : varchar(200)
    * start_date : date
    * benefits : text
    * status : enum('draft','sent','accepted','rejected','expired')
    * sent_at : timestamp
    * responded_at : timestamp
    * created_at : timestamp
  }
}

' ============================================================
' MODULE: Xác thực (Tham chiếu)
' Giải quyết: FR-001 (Đăng ký người dùng)
' ============================================================
package "Module Xác thực (Tham chiếu)" #F3E5F5 {
  entity "auth_users" as auth_users {
    * id : bigint <<PK>>
    --
    * username : varchar(50) <<UNIQUE>>
    * email : varchar(100) <<UNIQUE>>
    * full_name : varchar(100)
    * role : enum('admin','hr_manager','recruiter','interviewer')
  }
}

' ============================================================
' QUAN HỆ
' ============================================================

' --- Người dùng ---
users ||--o| candidates : "là ứng viên"
users ||--o| employers : "là nhà tuyển dụng"
users ||--o| hr_profiles : "là HR"

' --- Việc làm ---
employers ||--o{ jobs : "đăng tin"
users ||--o{ jobs : "phê duyệt bởi"
jobs ||--o{ job_requirements : "có"

' --- Hồ sơ ---
jobs ||--o{ applications : "có"
candidates ||--o{ applications : "nộp"

' --- Phỏng vấn ---
applications ||--o{ interviews : "lên lịch"
users ||--o{ interviews : "tiến hành"

' --- Đánh giá ---
interviews ||--o{ evaluations : "có"
users ||--o{ evaluations : "đánh giá bởi"

' --- Đề nghị ---
applications ||--o{ offers : "có thể nhận"

@enduml
