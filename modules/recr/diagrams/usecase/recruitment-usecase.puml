@startuml
' ============================================================
' Hệ thống Tuyển dụng - Sơ đồ Use Case
' Vai trò: Ứng viên, HR, Nhà tuyển dụng
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
}

skinparam nodesep 60
skinparam ranksep 40

' --- Actors ---
actor "Ứng viên" as candidate
actor "HR" as hr
actor "Nhà tuyển dụng" as employer

' --- Force actor order ---
candidate -[hidden]down- hr
hr -[hidden]down- employer

' --- Use Cases - Ứng viên ---
usecase "UC-03: Tìm việc" as UC03
usecase "UC-04: Nộp hồ sơ" as UC04
usecase "UC-05: Xem trạng thái hồ sơ" as UC05
usecase "UC-06: Cập nhật hồ sơ" as UC06
usecase "UC-07: Tải lên CV" as UC07

' --- Use Cases - HR ---
usecase "UC-08: Xem hồ sơ" as UC08
usecase "UC-09: Lọc ứng viên" as UC09
usecase "UC-10: Phỏng vấn" as UC10
usecase "UC-11: Đánh giá ứng viên" as UC11
usecase "UC-12: Gửi đề nghị" as UC12
usecase "UC-13: Từ chối ứng viên" as UC13
usecase "UC-14: Theo dõi quy trình" as UC14
usecase "UC-15: Tạo báo cáo" as UC15

' --- Use Cases - Nhà tuyển dụng ---
usecase "UC-16: Đăng tin tuyển dụng" as UC16
usecase "UC-17: Quản lý tin tuyển dụng" as UC17
usecase "UC-18: Xem ứng viên" as UC18

' --- Relationships - Ứng viên ---
candidate --> UC03
candidate --> UC04
candidate --> UC05
candidate --> UC06
candidate --> UC07

' --- Relationships - HR ---
hr --> UC08
hr --> UC09
hr --> UC10
hr --> UC11
hr --> UC12
hr --> UC13
hr --> UC14
hr --> UC15

' --- Relationships - Nhà tuyển dụng ---
employer --> UC16
employer --> UC17
employer --> UC18

' --- Include/Extend ---
UC08 ..> UC09 : <<include>>
UC10 ..> UC11 : <<include>>
UC12 ..> UC14 : <<extend>>
UC13 ..> UC14 : <<extend>>

@enduml
