@startuml Upload CV Sequence
title UC-05: Tải lên CV/Hồ sơ

skinparam sequenceArrowThickness 1
skinparam sequenceParticipantPadding 5
skinparam sequenceLifeLineBorderColor #333
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

skinparam responseMessageBelowArrow true
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 200
skinparam sequenceParticipantPadding 20

actor "Người dùng" as U
participant "Client" as Client
participant "FILE Service" as FILE
database "PostgreSQL" as DB
participant "Filesystem" as FS

U -> Client : Chọn tệp CV
Client -> FILE : POST /files/upload\n(multipart/form-data)\n{category: RESUME}
activate FILE
FILE -> FILE : Kiểm tra loại (PDF/DOC/DOCX)\n& kích thước (≤10MB)
FILE -> DB : Kiểm tra RESUME hiện có
activate DB
DB --> FILE : existing_cv
deactivate DB

alt Tìm thấy CV hiện có
  FILE -> DB : UPDATE cũ → REPLACED
  activate DB
  DB --> FILE : OK
  deactivate DB
end

FILE -> FILE : Tạo tên file UUID
FILE -> FS : Lưu tệp CV vào disk\nuploads/{user_id}/RESUME/{uuid}
activate FS
FS --> FILE : OK
deactivate FS
FILE -> DB : INSERT metadata\n(status: ACTIVE)
activate DB
DB --> FILE : file record
deactivate DB
FILE --> Client : bản ghi tệp tin
deactivate FILE

Client --> U : CV đã tải lên

@enduml
