@startuml File Management - External Systems
title Trường hợp Sử dụng &mdash; Hệ thống Bên ngoài

skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam responseMessageBelowArrow true
skinparam usecaseFontSize 11
skinparam rectangleFontSize 13
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 40
skinparam padding 5

left to right direction

rectangle "Module Quản lý Tệp tin" as FMM {
  usecase "Tải lên" as UC05
  usecase "Tải xuống" as UC06
  usecase "Xóa" as UC09
  usecase "Ghi nhật ký" as UC12
}

rectangle "Hệ thống Bên ngoài" as EXT {
  usecase "Local\nFilesystem" as LFS
  usecase "Database" as DB
  usecase "RabbitMQ" as MQ
}

UC05 --> LFS
UC05 --> DB
UC05 --> MQ

UC06 --> LFS

UC09 --> LFS
UC09 --> DB

UC12 --> MQ

@enduml
