@startuml
title Sơ đồ Trường hợp Sử dụng — Cốt lõi

skinparam defaultTextAlignment center
skinparam responseMessageBelowArrow true
skinparam usecaseFontSize 11
skinparam actorFontSize 13
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 30

actor "Người dùng" as User
actor "Quản trị viên" as Admin
actor "Hệ thống" as System

rectangle "Module Quản lý Tệp tin" {
  usecase "Tạo Thư mục" as UC01
  usecase "Liệt kê" as UC02
  usecase "Tải lên" as UC05
  usecase "Tải xuống" as UC06
  usecase "Xóa" as UC09
  usecase "Tải lên CV" as UC05a
  usecase "Quản lý quyền" as UC13
}

User --> UC01
User --> UC02
User --> UC05
User --> UC06
User --> UC05a

Admin --> UC09
Admin --> UC13

@enduml
