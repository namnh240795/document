@startuml FILE Component Diagram
title FILE Module - Sơ đồ Thành phần

skinparam componentFontSize 11
skinparam nodesep 20
skinparam ranksep 25
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam wrapWidth 180

skinparam component<<internal>> {
  BackgroundColor #FEFECE
  BorderColor #888888
}
skinparam component<<util>> {
  BackgroundColor #E8F5E9
  BorderColor #4CAF50
}
skinparam component<<external>> {
  BackgroundColor #BFDFFF
  BorderColor #888888
}

' === LAYER 1: API Gateway ===
rectangle "API Gateway" {
  component "FileController" as FC <<internal>>
  component "FileGuard" as FG <<internal>>
}

' === LAYER 2: Business Logic ===
rectangle "Business Logic" {
  component "FileService" as FS <<internal>>
  component "FileWorker" as FW <<internal>>
  component "TempCleanupJob" as TCJ <<internal>>
}

' === LAYER 3: Utilities ===
rectangle "Utilities" {
  component "MulterUtil" as MU <<util>>
  component "FileUtil" as FU <<util>>
  component "NameResolver" as NRU <<util>>
}

' === LAYER 4: External Services ===
rectangle "External Services" {
  component "PostgreSQL\n(file_db)" as DB <<external>>
  component "Filesystem\n(uploads/)" as LFS <<external>>
  component "RabbitMQ" as RMQ <<external>>
  component "AuthGuard\n(AUTH)" as AG <<external>>
  component "Scheduler" as SCH <<external>>
}

' === Connections ===
FC --> FG : auth
FC --> FS : delegate
FG --> AG : verify

FS --> MU : upload
FS --> FU : file ops
FS --> NRU : resolve
FS --> DB : query
FS --> LFS : read/write
FS --> RMQ : publish

FW --> RMQ : consume
FW --> FU : delete

TCJ --> SCH : schedule
TCJ --> FS : cleanup

@enduml
