@startuml ERD File Management
title ERD - Quản lý Tệp tin (file_db)

skinparam classFontSize 12
skinparam classAttributeFontSize 10
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 20
skinparam linetype ortho
skinparam shadowing false
skinparam class<<Core>> {
  BackgroundColor<<Core>> #E8F5E9
  BorderColor<<Core>> #4CAF50
}
skinparam class<<Stats>> {
  BackgroundColor<<Stats>> #E3F2FD
  BorderColor<<Stats>> #2196F3
}
skinparam class<<Config>> {
  BackgroundColor<<Config>> #FFF8E1
  BorderColor<<Config>> #FFC107
}
skinparam class<<External>> {
  BackgroundColor<<External>> #FFEBEE
  BorderColor<<External>> #F44336
}

' === External Reference ===
class auth_users <<External>> <<E>> {
  id : UUID PK
}

' === Core Tables ===
class sys_files <<Core>> <<T>> {
  id : UUID PK
  employer_id : UUID FK
  user_id : UUID FK NOT NULL
  parent_folder_id : UUID FK (self)
  type : VARCHAR(10) NOT NULL
  original_name : VARCHAR(500) NOT NULL
  file_path : VARCHAR(1000)
  mime_type : VARCHAR(100)
  file_size : BIGINT DEFAULT 0
  category : VARCHAR(50) NOT NULL
  is_public : BOOLEAN NOT NULL
  status : VARCHAR(20) NOT NULL
  search_vector : TSVECTOR
  created_at : TIMESTAMP NOT NULL
  updated_at : TIMESTAMP NOT NULL
  deleted_at : TIMESTAMP
}

class sys_file_permissions <<Core>> <<T>> {
  id : UUID PK
  file_id : UUID FK NOT NULL
  user_id : UUID FK
  role : VARCHAR(50)
  org_id : UUID
  permission : VARCHAR(20) NOT NULL
  created_at : TIMESTAMP NOT NULL
  updated_at : TIMESTAMP NOT NULL
}

' === Stats Tables ===
class sys_storage_usage <<Stats>> <<T>> {
  id : UUID PK
  user_id : UUID FK
  org_id : UUID
  total_size : BIGINT NOT NULL
  file_count : INTEGER NOT NULL
  last_calculated_at : TIMESTAMP NOT NULL
}

' === Config Tables ===
class sys_storage_quotas <<Config>> <<T>> {
  id : UUID PK
  user_id : UUID FK
  org_id : UUID
  max_total_size : BIGINT NOT NULL
  max_file_count : INTEGER NOT NULL
  created_at : TIMESTAMP NOT NULL
  updated_at : TIMESTAMP NOT NULL
}

class sys_storage_policies <<Config>> <<T>> {
  id : UUID PK
  category : VARCHAR(50) NOT NULL UNIQUE
  allowed_mime_types : JSONB NOT NULL
  max_file_size : BIGINT NOT NULL
  retention_days : INTEGER
  encryption_enabled : BOOLEAN NOT NULL
  created_at : TIMESTAMP NOT NULL
  updated_at : TIMESTAMP NOT NULL
}

' === Relationships ===
sys_files }o--|| auth_users : user_id
sys_files }o--o{ sys_files : parent_folder_id
sys_file_permissions }o--|| sys_files : file_id
sys_file_permissions }o--o| auth_users : user_id
sys_storage_usage }o--o| auth_users : user_id
sys_storage_quotas }o--o| auth_users : user_id

' === Notes ===
note top of sys_files
  FILE hoặc FOLDER.
  parent_folder_id hỗ trợ thư mục phân cấp.
  Trạng thái: TEMP → ACTIVE → DELETED | REPLACED
  Danh mục: RESUME, AVATAR, COMPANY_DOC, JOB_ATTACHMENT, OTHER
end note

note top of sys_file_permissions
  Chính xác một trong ba: user_id, role, hoặc org_id
  (CHECK constraint)
  Quyền: VIEW, DOWNLOAD, EDIT, DELETE
end note

note right of sys_storage_usage
  Tính bởi cron job (mỗi giờ).
  Phạm vi: user HOẶC org (không cả hai).
end note

note right of sys_storage_policies
  Một dòng mỗi danh mục.
  Chỉ áp dụng cho tải lên mới.
end note

@enduml
