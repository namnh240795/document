@startuml
' ============================================================
' Sơ đồ Hoạt động - Quy trình Đăng nhập (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quy trình Đăng nhập

start

:Nhập email/số điện thoại + mật khẩu;

:Tìm người dùng theo email/số điện thoại;

if (Tìm thấy người dùng?) then (no)
  :Trả về INVALID_CREDENTIALS;
  stop
endif

:Xác minh mật khẩu;

if (Mật khẩu đúng?) then (no)
  :Trả về INVALID_CREDENTIALS;
  stop
endif

if (Tài khoản đã xác minh?) then (no)
  :Trả về ACCOUNT_NOT_VERIFIED;
  stop
endif

:Tạo phiên làm việc + Tạo JWT tokens;

:Trả về tokens cho client;

:Lưu tokens + Điều hướng đến trang quản trị;

stop

@enduml
