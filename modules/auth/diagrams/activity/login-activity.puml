@startuml
' ============================================================
' Activity Diagram - Login Flow (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Login Flow

start

:Enter email/phone + password;

:Find user by email/phone;

if (User found?) then (no)
  :Return INVALID_CREDENTIALS;
  stop
endif

:Verify password;

if (Password correct?) then (no)
  :Return INVALID_CREDENTIALS;
  stop
endif

if (Account verified?) then (no)
  :Return ACCOUNT_NOT_VERIFIED;
  stop
endif

:Create session + Generate JWT tokens;

:Return tokens to client;

:Store tokens + Redirect to Dashboard;

stop

@enduml
