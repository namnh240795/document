@startuml
' ============================================================
' Sơ đồ Hoạt động - Khóa Tài khoản & Đăng nhập với tư cách người dùng khác
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Khóa Tài khoản & Đăng nhập với tư cách người dùng khác

start

:Admin chọn người dùng;

if (Hành động?) then (ban)
  :Nhập lý do khóa + thời hạn tùy chọn;
  :Khóa tài khoản;
  :Hủy tất cả phiên làm việc của người dùng;
elseif (unban) then
  :Mở khóa tài khoản;
elseif (impersonate) then
  :Tạo phiên admin với tư cách người dùng mục tiêu;
  :Điều hướng đến trang quản trị của người dùng mục tiêu;
endif

:Trả về phản hồi thành công;

stop

@enduml
