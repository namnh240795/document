@startuml
' ============================================================
' Sơ đồ Hoạt động - Gửi lại Lời mời
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Gửi lại Lời mời

start

:Admin chọn lời mời để gửi lại;

if (Lời mời đã chấp nhận?) then (yes)
  :Trả về 409 Conflict;
  stop
endif

:Tạo token mới\n(token cũ bị hủy);

:Đặt lại trạng thái thành PENDING;

:Gia hạn thời hạn thêm 72 giờ;

:Gửi email lời mời mới\nqua EMAIL module;

:Trả về phản hồi thành công;

stop

@enduml
