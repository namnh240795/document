@startuml
' ============================================================
' Sơ đồ Hoạt động - Làm mới Token
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Làm mới Token

start

:Client phát hiện access token hết hạn;

:Gửi refresh token đến /auth/refresh;

:Kiểm tra refresh token + phiên làm việc;

if (Token hợp lệ?) then (yes)
  :Tạo access token mới;
  :Trả về token mới;
else (no)
  :Trả về 401 Unauthorized;
  :Người dùng phải đăng nhập lại;
endif

stop

@enduml
