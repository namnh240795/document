@startuml
' ============================================================
' Sơ đồ Hoạt động - Quản lý Lời mời
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quản lý Lời mời

skinparam activityFontSize 11
skinparam activityPadding 5
skinparam activityBorderThickness 1
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

start

:Admin nhập email người được mời + vai trò;

:Tạo token ngẫu nhiên\n(hash SHA-256 được lưu);

if (Lời mời đang chờ trùng lặp?) then (yes)
  :Trả về 409 Conflict;
  stop
endif

:Lưu hash token vào auth_invitations;

:Gửi email lời mời qua EMAIL module\n(token thô trong URL);

:Người được mời nhận email;

:Người được mời nhấp vào liên kết lời mời;

:Frontend gọi endpoint xác minh\n(công khai, không cần xác thực);

:System kiểm tra token;

if (Token hợp lệ?) then (yes)
  :Hiển thị chi tiết lời mời;
  :Người được mời chấp nhận hoặc từ chối;
  if (Chấp nhận?) then (yes)
    :Thêm người dùng vào tổ chức\nvới vai trò đã chỉ định;
  else (no)
    :Cập nhật trạng thái thành đã từ chối;
  endif
else (no)
  :Hiển thị lỗi\n(hết hạn/đã thu hồi/không hợp lệ);
endif

stop

@enduml
