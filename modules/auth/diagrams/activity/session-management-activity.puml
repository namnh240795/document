@startuml
' ============================================================
' Sơ đồ Hoạt động - Quản lý Phiên làm việc
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quản lý Phiên làm việc

start

:Điều hướng đến cài đặt phiên làm việc;

:Hiển thị các phiên làm việc đang hoạt động\n(thiết bị, IP, lần hoạt động cuối);

if (Chọn hành động?) then (revoke one)
  :Chọn phiên làm việc cụ thể;
  :Hủy phiên làm việc;
elseif (revoke all others) then
  :Hủy tất cả ngoại trừ phiên hiện tại;
endif

:Trả về danh sách phiên làm việc đã cập nhật;

stop

@enduml
