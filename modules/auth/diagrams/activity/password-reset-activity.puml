@startuml
' ============================================================
' Sơ đồ Hoạt động - Đặt lại Mật khẩu (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quy trình Đặt lại Mật khẩu

start

:Nhập email/số điện thoại để đặt lại mật khẩu;

if (Đã yêu cầu trong 5 phút trước?) then (yes)
  :Hiển thị "Kiểm tra email/số điện thoại của bạn";
  stop
endif

:Tìm người dùng + Tạo token đặt lại;

:Gửi liên kết đặt lại/mã OTP qua RabbitMQ;

:Người dùng nhấp liên kết / nhập mã OTP;

:Kiểm tra token;

if (Token hợp lệ?) then (no)
  :Hiển thị "Không hợp lệ hoặc đã hết hạn";
  stop
endif

:Cập nhật mật khẩu + Hủy tất cả phiên làm việc;

:Hiển thị "Mật khẩu đã được cập nhật";

stop

@enduml
