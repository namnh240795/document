@startuml
' ============================================================
' Activity Diagram - Password Reset Flow
' Simplified without swimlanes
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Password Reset Flow

start

:Enter email or phone for password reset;

:Check idempotency key in Redis;

if (Already requested within 5 min?) then (yes)
  :Show "Check your email/phone";
  stop
endif

:Find user by email/phone;

if (User exists?) then (no)
  :Show "If account exists, reset link sent";
  stop
endif

:Set idempotency key (Redis, 5 min TTL);

:Generate secure reset token;

:Store verification record in auth_verification;

:Publish password.reset event to RabbitMQ;

:Show "Check your email/phone";

:Send reset link to email or OTP to phone;

:User clicks reset link or enters OTP;

:Validate reset token (not expired, not used);

if (Token valid?) then (no)
  :Show "Invalid or expired link";
  stop
endif

:Hash new password (bcrypt, 12 rounds);

:Update password in auth_users;

:Mark token as used in auth_verification;

:Delete all active sessions (invalidate other devices);

:Show "Password updated successfully";

:Login with new password;

stop

@enduml
