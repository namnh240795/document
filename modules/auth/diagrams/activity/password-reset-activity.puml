@startuml
' ============================================================
' Activity Diagram - Password Reset Flow (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Password Reset Flow

start

:Enter email/phone for reset;

if (Already requested within 5 min?) then (yes)
  :Show "Check your email/phone";
  stop
endif

:Find user + Generate reset token;

:Send reset link/OTP via RabbitMQ;

:User clicks link / enters OTP;

:Validate token;

if (Token valid?) then (no)
  :Show "Invalid or expired";
  stop
endif

:Update password + Invalidate sessions;

:Show "Password updated";

stop

@enduml
