@startuml
' ============================================================
' Activity Diagram - Change Password Flow
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Change Password Flow

start

:Navigate to change password page;

:Enter current password + new password;

:Verify current password;

if (Current password correct?) then (yes)
  :Hash new password;
  :Update password hash in DB;
  :Return success;
else (no)
  :Return 401 Unauthorized;
endif

stop

@enduml
