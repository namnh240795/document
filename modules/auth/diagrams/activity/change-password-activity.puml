@startuml
' ============================================================
' Sơ đồ Hoạt động - Đổi Mật khẩu (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quy trình Đổi Mật khẩu

skinparam activityFontSize 11
skinparam activityPadding 5
skinparam activityBorderThickness 1
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

start

:Điều hướng đến trang đổi mật khẩu;

:Nhập mật khẩu hiện tại + mật khẩu mới;

:Xác minh mật khẩu hiện tại;

if (Mật khẩu hiện tại đúng?) then (yes)
  :Mã hóa mật khẩu mới;
  :Cập nhật mật khẩu trong DB;
  :Trả về thành công;
else (no)
  :Trả về 401 Unauthorized;
endif

stop

@enduml
