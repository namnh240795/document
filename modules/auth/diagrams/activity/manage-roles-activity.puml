@startuml
' ============================================================
' Activity Diagram - Manage Roles Flow
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Manage Roles Flow

start

:Admin navigates to role management;

:System displays role list;

if (Action selected?) then (create)
  :Enter role name + permissions;
  :Validate (unique name, valid permissions);
  :Create role record;
elseif (assign) then
  :Select user + role;
  :Assign role to user;
elseif (remove) then
  :Select user + role;
  :Remove role from user;
endif

:Return success response;

stop

@enduml
