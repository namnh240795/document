@startuml
' ============================================================
' Sơ đồ Hoạt động - Quản lý Vai trò
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quản lý Vai trò

start

:Admin điều hướng đến quản lý vai trò;

:System hiển thị danh sách vai trò;

if (Chọn hành động?) then (create)
  :Nhập tên vai trò + quyền hạn;
  :Kiểm tra (tên duy nhất, quyền hạn hợp lệ);
  :Tạo bản ghi vai trò;
elseif (assign) then
  :Chọn người dùng + vai trò;
  :Gán vai trò cho người dùng;
elseif (remove) then
  :Chọn người dùng + vai trò;
  :Gỡ bỏ vai trò khỏi người dùng;
endif

:Trả về phản hồi thành công;

stop

@enduml
