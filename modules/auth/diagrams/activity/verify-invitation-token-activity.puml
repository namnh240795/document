@startuml
' ============================================================
' Sơ đồ Hoạt động - Xác minh Token Lời mời
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Xác minh Token Lời mời

skinparam activityFontSize 11
skinparam activityPadding 5
skinparam activityBorderThickness 1
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

start

:Người dùng nhấp liên kết lời mời\ntrong email;

:Frontend gọi GET\n/organization/verify-invitation?token={raw_token};

:System tính toán hash SHA-256;

:System tìm kiếm lời mời\ntheo token_hash;

if (Tìm thấy token?) then (yes)
  if (Trạng thái?) then (pending)
    if (Đã hết hạn?) then (yes)
      :Tự động cập nhật trạng thái thành EXPIRED;
      :Trả về { valid: false, reason: "expired" };
    else (no)
      :Trả về { valid: true, invitation };
    endif
  elseif (accepted) then
    :Trả về { valid: false, reason: "accepted" };
  elseif (revoked) then
    :Trả về { valid: false, reason: "revoked" };
  endif
else (no)
  :Trả về 404 Token không hợp lệ;
endif

stop

@enduml
