@startuml
' ============================================================
' Sơ đồ Hoạt động - Quản lý Nhóm
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quản lý Nhóm

skinparam activityFontSize 11
skinparam activityPadding 5
skinparam activityBorderThickness 1
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

start

:Admin tạo nhóm\ntrong tổ chức;

if (Hành động?) then (create)
  :Nhập tên nhóm;
  :Kiểm tra (duy nhất trong tổ chức);
  :Tạo bản ghi nhóm;
elseif (add member) then
  :Chọn thành viên từ tổ chức;
  :Thêm vào nhóm;
elseif (remove member) then
  :Chọn thành viên nhóm;
  :Xóa khỏi nhóm;
elseif (delete team) then
  :Xác nhận xóa;
  :Xóa bản ghi nhóm;
endif

:Trả về phản hồi thành công;

stop

@enduml
