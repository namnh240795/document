@startuml
' ============================================================
' Sơ đồ Hoạt động - Thu hồi Lời mời
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Thu hồi Lời mời

skinparam activityFontSize 11
skinparam activityPadding 5
skinparam activityBorderThickness 1
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

start

:Admin chọn lời mời để thu hồi;

if (Kiểm tra chủ sở hữu?) then (yes)
  if (Trạng thái?) then (pending)
    :Cập nhật trạng thái thành REVOKED;
    :Phát sự kiện invitation.revoked;
    :Trả về thành công;
  elseif (accepted) then
    :Trả về 409\nKhông thể thu hồi lời mời đã chấp nhận;
  elseif (revoked) then
    :Trả về 409\nĐã thu hồi;
  endif
else (no)
  :Trả về 403 Forbidden;
endif

stop

@enduml
