@startuml
' ============================================================
' Sơ đồ Hoạt động - Đăng nhập Xã hội
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Đăng nhập Xã hội

skinparam activityFontSize 11
skinparam activityPadding 5
skinparam activityBorderThickness 1
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

start

:Nhấp "Đăng nhập với Provider";

:Điều hướng đến OAuth provider;

:Người dùng xác thực với provider;

:Provider chuyển hướng với mã xác thực;

:Đổi mã lấy tokens;

if (Người dùng tồn tại?) then (yes)
  :Liên kết tài khoản xã hội với người dùng hiện tại;
else (no)
  :Tạo tài khoản người dùng mới;
  :Liên kết tài khoản xã hội;
endif

:Tạo phiên làm việc + Cấp JWT;

stop

@enduml
