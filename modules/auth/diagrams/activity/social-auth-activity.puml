@startuml
' ============================================================
' Activity Diagram - Social Authentication Flow
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Social Authentication Flow

start

:Click "Sign in with Provider";

:Redirect to OAuth provider;

:User authenticates with provider;

:Provider redirects with auth code;

:Exchange code for tokens;

if (User exists?) then (yes)
  :Link social account to existing user;
else (no)
  :Create new user account;
  :Link social account;
endif

:Create session + Issue JWT;

stop

@enduml
