@startuml
' ============================================================
' Activity Diagram - Logout Flow
' Simplified without swimlanes
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Logout Flow

start

:Click "Logout";

:Decode JWT token (extract session ID);

:Delete session from auth_sessions;

:Clear cached session in Redis;

:Return success;

:Clear tokens from memory/cookie;

:Redirect to Login page;

stop

@enduml
