@startuml
' ============================================================
' Sơ đồ Hoạt động - Quản lý Tổ chức
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quản lý Tổ chức

skinparam activityFontSize 11
skinparam activityPadding 5
skinparam activityBorderThickness 1
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

start

:Người dùng tạo tổ chức\n(tên, slug);

:Kiểm tra tính duy nhất của slug;

if (Slug khả dụng?) then (yes)
  :Tạo bản ghi tổ chức;
  :Gán người dùng là chủ sở hữu\nvới vai trò Employer;
else (no)
  :Trả về 409 Conflict;
  stop
endif

:Chủ sở hữu có thể quản lý tổ chức\n(cập nhật, thành viên, vai trò);

stop

@enduml
