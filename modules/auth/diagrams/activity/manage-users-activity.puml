@startuml
' ============================================================
' Sơ đồ Hoạt động - Quản lý Người dùng
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quản lý Người dùng

skinparam activityFontSize 11
skinparam activityPadding 5
skinparam activityBorderThickness 1
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

start

:Admin điều hướng đến quản lý người dùng;

:System hiển thị danh sách người dùng\n(phân trang, tìm kiếm);

if (Chọn hành động?) then (view)
  :Hiển thị chi tiết người dùng;
elseif (update) then
  :Chỉnh sửa thông tin người dùng;
  :Kiểm tra thay đổi;
  :Cập nhật bản ghi người dùng;
elseif (delete) then
  :Xác nhận xóa;
  :Xóa bản ghi người dùng;
  :Thu hồi tất cả phiên làm việc;
endif

:Trả về phản hồi thành công;

stop

@enduml
