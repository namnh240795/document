@startuml
' ============================================================
' Activity Diagram - Account Verification (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Account Verification Flow

start

:Request verification;

if (Already sent within 5 min?) then (yes)
  :Show "Already sent";
  stop
endif

:Generate OTP + Store verification;

:Publish event to RabbitMQ;

:Worker sends SMS via Twilio;

if (SMS sent?) then (yes)
  :Log as sent;
else (no)
  :Log as failed + Retry;
endif

:Update verification status;

stop

@enduml
