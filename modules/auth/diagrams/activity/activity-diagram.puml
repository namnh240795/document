@startuml
' ============================================================
' Activity Diagram - Account Verification Flow
' Simplified without swimlanes
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Account Verification Flow

start

:User requests account verification;

:Check idempotency key in Redis;

if (Already sent within 5 min?) then (yes)
  :Return "Already sent" (idempotent);
  :Show "Verification already sent";
  stop
endif

:Set idempotency key (Redis, 5 min TTL);

:Generate verification token/OTP;

:Store in auth_verification;

:Publish event to verification.sms queue;

:Return "Verification sent";

:Show "Verification sent";

:Worker consumes event from RabbitMQ;

:Send OTP via Twilio;

if (SMS sent?) then (yes)
  :Log delivery to sms_db (status: sent);
else (no)
  :Log failure to sms_db (status: failed);
  :Route to Dead Letter Queue for retry;
endif

:Update auth_verification status = sent;

stop

@enduml
