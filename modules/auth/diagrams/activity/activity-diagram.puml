@startuml
' ============================================================
' Sơ đồ Hoạt động - Quy trình Xác minh Tài khoản (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quy trình Xác minh Tài khoản

start

:Yêu cầu xác minh;

if (Đã gửi trong 5 phút trước?) then (yes)
  :Hiển thị "Đã gửi";
  stop
endif

:Tạo mã OTP + Lưu thông tin xác minh;

:Publish sự kiện đến RabbitMQ;

:Worker gửi SMS qua Twilio;

if (SMS đã gửi?) then (yes)
  :Ghi log đã gửi;
else (no)
  :Ghi log thất bại + Thử lại;
endif

:Cập nhật trạng thái xác minh;

stop

@enduml
