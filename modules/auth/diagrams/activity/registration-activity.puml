@startuml
' ============================================================
' Sơ đồ Hoạt động - Quy trình Đăng ký (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Quy trình Đăng ký

start

:Điền form đăng ký;

:Kiểm tra dữ liệu đầu vào;

if (Dữ liệu hợp lệ?) then (no)
  :Hiển thị lỗi;
  stop
endif

:Kiểm tra email/số điện thoại đã tồn tại;

if (Đã đăng ký?) then (yes)
  :Hiển thị "Đã đăng ký";
  stop
endif

:Mã hóa mật khẩu + Tạo bản ghi người dùng;

:Gán vai trò mặc định + Tạo mã OTP;

:Gửi xác minh qua RabbitMQ;

:Trả về "Đăng ký thành công";

:Gửi OTP đến email/số điện thoại;

stop

@enduml
