@startuml
' ============================================================
' Activity Diagram - Registration Flow (Compact for A4)
' ============================================================

skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFCC00
  DiamondBorderColor #333333
}

title Registration Flow

start

:Fill registration form;

:Validate input;

if (Input valid?) then (no)
  :Show errors;
  stop
endif

:Check if email/phone exists;

if (Already registered?) then (yes)
  :Show "Already registered";
  stop
endif

:Hash password + Create user record;

:Assign default role + Generate OTP;

:Send verification via RabbitMQ;

:Return "Registration successful";

:Send OTP to phone/email;

stop

@enduml
