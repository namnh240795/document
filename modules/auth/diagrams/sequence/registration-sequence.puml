@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Đăng ký
' Đăng ký Người dùng + Xác minh Email/Phone
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Đăng ký Người dùng

actor User
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB
queue "RabbitMQ" as MQ
participant "Notification\nWorker" as Worker
participant "Email/SMS\nService" as Notif

== Bước 1: Yêu cầu đăng ký ==

User -> FE : Điền form đăng ký\n(tên, email/số điện thoại, mật khẩu)
activate FE

FE -> API : POST /auth/register\n{ name, email, phone, password }
activate API

== Bước 2: Kiểm tra dữ liệu ==

API -> API : Kiểm tra định dạng dữ liệu\n(định dạng email, độ mạnh mật khẩu)

alt Kiểm tra dữ liệu thất bại
  API --> FE : 400 VALIDATION_ERROR
  FE --> User : Hiển thị lỗi kiểm tra
end

== Bước 3: Kiểm tra trùng lặp ==

API -> DB : SELECT * FROM auth_users\nWHERE email = ? OR phone = ?
activate DB
DB --> API : Kết quả
deactivate DB

alt Email/số điện thoại đã tồn tại
  API --> FE : 409 CONFLICT
  FE --> User : Hiển thị "Đã đăng ký"
end

== Bước 4: Mã hóa mật khẩu ==

API -> API : bcrypt.hash(password, 12)

== Bước 5: Tạo người dùng ==

API -> DB : INSERT INTO auth_users\n(name, email, phone, password_hash)
activate DB
DB --> API : Đã tạo người dùng (id: uuid)
deactivate DB

== Bước 6: Tạo bản ghi tài khoản ==

API -> DB : INSERT INTO auth_accounts\n(user_id, provider: 'credential')
activate DB
DB --> API : Đã tạo tài khoản
deactivate DB

== Bước 7: Tạo vai trò mặc định ==

API -> DB : INSERT INTO auth_user_roles\n(user_id, role_id: 'customer')
activate DB
DB --> API : Đã gán vai trò
deactivate DB

== Bước 8: Tạo mã xác minh ==

API -> API : Tạo mã xác minh\n(OTP 6 chữ số)

API -> DB : INSERT INTO auth_verification\n(user_id, code, type, expires_at)
activate DB
DB --> API : Bản ghi xác minh
deactivate DB

== Bước 9: Gửi xác minh ==

API -> MQ : PUBLISH verification.requested\n{ userId, phone, channel, otp }
activate MQ
MQ --> API : Đã xếp hàng
deactivate MQ

== Bước 10: Phản hồi ==

API --> FE : 201 { user: { id, name, email, emailVerified: false } }
deactivate API

FE --> User : Hiển thị "Đăng ký thành công"\n+ "Vui lòng xác minh tài khoản"
deactivate FE

== Bước 11: Bất đồng bộ - Gửi xác minh ==

MQ -> Worker : CONSUME verification.requested
activate Worker

Worker -> Notif : Gửi OTP qua số điện thoại\nhoặc email xác minh
activate Notif
Notif --> Worker : Đã gửi
deactivate Notif

Worker -> DB : UPDATE auth_verification\nSET status = 'sent'
activate DB
DB --> Worker : Đã cập nhật
deactivate DB

Worker -> MQ : ACK
deactivate Worker

@enduml
