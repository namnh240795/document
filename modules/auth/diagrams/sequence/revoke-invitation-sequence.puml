@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Thu hồi Lời mời
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Thu hồi Lời mời

skinparam sequenceArrowThickness 1
skinparam sequenceParticipantPadding 5
skinparam sequenceLifeLineBorderColor #333
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB
queue "RabbitMQ" as MQ

== Bước 1: Thu hồi lời mời ==

Admin -> FE : Chọn lời mời cần thu hồi
activate FE

FE -> API : DELETE /organization/cancel-invitation\n{ invitationId }
activate API

API -> DB : SELECT * FROM auth_invitations\nWHERE id = ?
activate DB
DB --> API : Lời mời
deactivate DB

== Bước 2: Kiểm tra quyền sở hữu ==

API -> API : Xác minh inviter_id == current user id

alt Không phải chủ sở hữu
  API --> FE : 403 Forbidden
end

alt Đã chấp nhận hoặc đã thu hồi
  API --> FE : 409 Không thể thu hồi
end

== Bước 3: Cập nhật trạng thái ==

API -> DB : UPDATE auth_invitations\nSET status = 'revoked'\nWHERE id = ?
activate DB
DB --> API : Đã cập nhật
deactivate DB

== Bước 4: Gửi sự kiện ==

API -> MQ : PUBLISH invitation.revoked\n{ invitationId, email, role, revokedBy }
activate MQ
MQ --> API : Đã xếp hàng
deactivate MQ

API --> FE : 200 { message: "Đã thu hồi" }
deactivate API

FE --> Admin : "Đã thu hồi lời mời"
deactivate FE

@enduml
