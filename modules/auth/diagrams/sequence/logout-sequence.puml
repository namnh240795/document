@startuml
' ============================================================
' Sequence Diagram - Logout Flow
' Session Invalidation + Token Cleanup
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sequence Diagram: User Logout Flow

actor User
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB
database "Redis\n(Cache)" as Redis

== Step 1: Logout Request ==

User -> FE : Click "Logout"
activate FE

FE -> API : POST /auth/logout\nAuthorization: Bearer {accessToken}
activate API

== Step 2: Validate Token ==

API -> API : Decode JWT\nextract session/user ID

== Step 3: Delete Session ==

API -> DB : DELETE FROM auth_sessions\nWHERE id = ? AND user_id = ?
activate DB
DB --> API : Session deleted
deactivate DB

== Step 4: Clear Cache ==

API -> Redis : DEL session:{userId}:{tokenId}
activate Redis
Redis --> API : Cache cleared
deactivate Redis

== Step 5: Response ==

API --> FE : 200 "Logged out successfully"
deactivate API

FE -> FE : Clear tokens\nfrom memory/cookie

FE --> User : Redirect to Login page
deactivate FE

@enduml
