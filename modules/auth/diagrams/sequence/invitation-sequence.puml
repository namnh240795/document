@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Quản lý Lời mời
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Quản lý Lời mời

skinparam sequenceArrowThickness 1
skinparam sequenceParticipantPadding 5
skinparam sequenceLifeLineBorderColor #333
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB
queue "RabbitMQ" as MQ
participant "EMAIL\nService" as Email
actor "Invitee" as Inv

== Bước 1: Gửi lời mời ==

Admin -> FE : Nhập email người được mời + vai trò
activate FE

FE -> API : POST /organization/invite-member\n{ organizationId, email, role }
activate API

API -> API : Tạo token\n(crypto.randomBytes(32))

API -> API : SHA-256 hash token

API -> DB : INSERT INTO auth_invitations\n(organization_id, email, token_hash,\nrole, inviter_id, expires_at)
activate DB
DB --> API : Đã tạo lời mời
deactivate DB

API -> MQ : PUBLISH invitation.created\n{ invitationId, email, role, inviteUrl }
activate MQ
MQ --> API : Đã xếp hàng
deactivate MQ

API --> FE : 200 { invitation }
deactivate API

FE --> Admin : "Đã gửi lời mời"
deactivate FE

== Bước 2: Gửi email (bất đồng bộ) ==

MQ -> Email : CONSUME invitation.created
activate Email

Email -> Inv : Gửi email lời mời\n(URL lời mời chứa raw token)
activate Inv
Inv --> Email : Đã nhận
deactivate Inv

deactivate Email

== Bước 3: Xác minh token (công khai) ==

Inv -> FE : Nhấp liên kết lời mời
activate FE

FE -> API : GET /organization/verify-invitation\n?token={raw_token}
activate API

API -> API : Hash token\n(SHA-256)

API -> DB : SELECT * FROM auth_invitations\nWHERE token_hash = ?
activate DB
DB --> API : Lời mời
deactivate DB

alt Token hợp lệ + chưa hết hạn
  API --> FE : 200 { valid: true, invitation }
else Đã hết hạn
  API -> DB : UPDATE auth_invitations\nSET status = 'expired'\nWHERE id = ?
  API --> FE : 200 { valid: false, reason: "expired" }
else Đã chấp nhận
  API --> FE : 200 { valid: false, reason: "accepted" }
end

deactivate API

FE --> Inv : Hiển thị chi tiết lời mời
deactivate FE

== Bước 4: Chấp nhận lời mời ==

Inv -> FE : Nhấp "Chấp nhận"
activate FE

FE -> API : POST /organization/accept-invitation\n{ invitationId }
activate API

API -> DB : UPDATE auth_invitations\nSET status = 'accepted',\naccepted_at = NOW()\nWHERE id = ?
activate DB
DB --> API : Đã cập nhật
deactivate DB

API -> DB : INSERT INTO auth_members\n(organization_id, user_id, role)
activate DB
DB --> API : Đã thêm thành viên
deactivate DB

API -> MQ : PUBLISH invitation.accepted\n{ invitationId, userId, role }
activate MQ
MQ --> API : Đã xếp hàng
deactivate MQ

API --> FE : 200 { success: true }
deactivate API

FE --> Inv : "Chào mừng! Bạn đã tham gia tổ chức"
deactivate FE

@enduml
