@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Quản lý Nhóm
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Quản lý Nhóm

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Tạo nhóm ==

Admin -> FE : Nhập tên nhóm
activate FE

FE -> API : POST /organization/create-team\n{ organizationId, name }
activate API

API -> DB : INSERT INTO auth_teams\n(name, organization_id)
activate DB
DB --> API : Đã tạo nhóm
deactivate DB

API --> FE : 200 { team }
deactivate API

FE --> Admin : "Đã tạo nhóm"
deactivate FE

== Bước 2: Thêm thành viên nhóm ==

Admin -> FE : Chọn thành viên cần thêm
activate FE

FE -> API : POST /organization/add-team-member\n{ teamId, userId }
activate API

API -> DB : INSERT INTO auth_team_members\n(team_id, user_id)
activate DB
DB --> API : Đã thêm thành viên
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Đã thêm thành viên vào nhóm"
deactivate FE

== Bước 3: Xóa thành viên nhóm ==

Admin -> FE : Chọn thành viên cần xóa
activate FE

FE -> API : POST /organization/remove-team-member\n{ teamId, userId }
activate API

API -> DB : DELETE FROM auth_team_members\nWHERE team_id = ? AND user_id = ?
activate DB
DB --> API : Đã xóa thành viên
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Đã xóa thành viên khỏi nhóm"
deactivate FE

== Bước 4: Xóa nhóm ==

Admin -> FE : Xóa nhóm
activate FE

FE -> API : POST /organization/remove-team\n{ teamId }
activate API

API -> DB : DELETE FROM auth_teams\nWHERE id = ?
activate DB
DB --> API : Đã xóa nhóm
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Đã xóa nhóm"
deactivate FE

@enduml
