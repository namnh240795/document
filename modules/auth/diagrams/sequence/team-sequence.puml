@startuml
' ============================================================
' Sequence Diagram - Team Management Flow
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sequence Diagram: Team Management Flow

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Step 1: Create Team ==

Admin -> FE : Enter team name
activate FE

FE -> API : POST /organization/create-team\n{ organizationId, name }
activate API

API -> DB : INSERT INTO auth_teams\n(name, organization_id)
activate DB
DB --> API : Team created
deactivate DB

API --> FE : 200 { team }
deactivate API

FE --> Admin : "Team created"
deactivate FE

== Step 2: Add Team Member ==

Admin -> FE : Select member to add
activate FE

FE -> API : POST /organization/add-team-member\n{ teamId, userId }
activate API

API -> DB : INSERT INTO auth_team_members\n(team_id, user_id)
activate DB
DB --> API : Member added
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Member added to team"
deactivate FE

== Step 3: Remove Team Member ==

Admin -> FE : Select member to remove
activate FE

FE -> API : POST /organization/remove-team-member\n{ teamId, userId }
activate API

API -> DB : DELETE FROM auth_team_members\nWHERE team_id = ? AND user_id = ?
activate DB
DB --> API : Member removed
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Member removed from team"
deactivate FE

== Step 4: Delete Team ==

Admin -> FE : Delete team
activate FE

FE -> API : POST /organization/remove-team\n{ teamId }
activate API

API -> DB : DELETE FROM auth_teams\nWHERE id = ?
activate DB
DB --> API : Team deleted
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Team deleted"
deactivate FE

@enduml
