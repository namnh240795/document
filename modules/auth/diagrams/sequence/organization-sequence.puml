@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Quản lý Tổ chức
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Quản lý Tổ chức

actor User
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Tạo tổ chức ==

User -> FE : Điền thông tin tổ chức
activate FE

FE -> API : POST /organization/create\n{ name, slug, logo }
activate API

API -> DB : SELECT slug FROM auth_organizations\nWHERE slug = ?
activate DB
DB --> API : Kiểm tra slug
deactivate DB

alt Slug đã tồn tại
  API --> FE : 409 CONFLICT
  FE --> User : Hiển thị "Slug đã tồn tại"
end

API -> DB : INSERT INTO auth_organizations\n(name, slug, logo)
activate DB
DB --> API : Đã tạo tổ chức (id)
deactivate DB

API -> DB : INSERT INTO auth_members\n(organization_id, user_id, role: 'Employer')
activate DB
DB --> API : Đã tạo thành viên (chủ sở hữu)
deactivate DB

API --> FE : 200 { organization }
deactivate API

FE --> User : "Đã tạo tổ chức"
deactivate FE

== Bước 2: Liệt kê tổ chức ==

User -> FE : Xem tổ chức
activate FE

FE -> API : GET /organization/list
activate API

API -> DB : SELECT o.* FROM auth_organizations o\nJOIN auth_members m ON o.id = m.organization_id\nWHERE m.user_id = ?
activate DB
DB --> API : Danh sách tổ chức
deactivate DB

API --> FE : 200 { organizations: [...] }
deactivate API

FE --> User : Hiển thị tổ chức
deactivate FE

== Bước 3: Quản lý thành viên ==

User -> FE : Xem thành viên
activate FE

FE -> API : GET /organization/list-members\n?organizationId=org-123
activate API

API -> DB : SELECT m.*, u.name, u.email\nFROM auth_members m\nJOIN auth_users u ON m.user_id = u.id\nWHERE m.organization_id = ?
activate DB
DB --> API : Danh sách thành viên
deactivate DB

API --> FE : 200 { members: [...] }
deactivate API

FE --> User : Hiển thị thành viên
deactivate FE

@enduml
