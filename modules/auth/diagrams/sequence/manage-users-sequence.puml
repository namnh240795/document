@startuml
' ============================================================
' Sequence Diagram - Manage Users Flow
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sequence Diagram: Manage Users Flow

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Step 1: List Users ==

Admin -> FE : Navigate to user management
activate FE

FE -> API : POST /admin/list-users\n{ limitValue, offsetValue }
activate API

API -> DB : SELECT * FROM auth_users\nORDER BY created_at DESC\nLIMIT ? OFFSET ?
activate DB
DB --> API : User list
deactivate DB

API --> FE : 200 { users: [...] }
deactivate API

FE --> Admin : Display user list
deactivate FE

== Step 2: Update User (optional) ==

Admin -> FE : Edit user
activate FE

FE -> API : POST /admin/update-user\n{ userId, name, role }
activate API

API -> DB : UPDATE auth_users\nSET name = ?, role = ?\nWHERE id = ?
activate DB
DB --> API : Updated
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "User updated"
deactivate FE

== Step 3: Delete User (optional) ==

Admin -> FE : Delete user
activate FE

FE -> API : POST /admin/remove-user\n{ userId }
activate API

API -> DB : DELETE FROM auth_users\nWHERE id = ?
activate DB
DB --> API : Deleted
deactivate DB

API -> DB : DELETE FROM auth_sessions\nWHERE user_id = ?
activate DB
DB --> API : Sessions revoked
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "User removed"
deactivate FE

@enduml
