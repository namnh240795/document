@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Quản lý Người dùng
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Quản lý Người dùng

skinparam sequenceArrowThickness 1
skinparam sequenceParticipantPadding 5
skinparam sequenceLifeLineBorderColor #333
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Liệt kê người dùng ==

Admin -> FE : Điều hướng đến quản lý người dùng
activate FE

FE -> API : POST /admin/list-users\n{ limitValue, offsetValue }
activate API

API -> DB : SELECT * FROM auth_users\nORDER BY created_at DESC\nLIMIT ? OFFSET ?
activate DB
DB --> API : Danh sách người dùng
deactivate DB

API --> FE : 200 { users: [...] }
deactivate API

FE --> Admin : Hiển thị danh sách người dùng
deactivate FE

== Bước 2: Cập nhật người dùng (tùy chọn) ==

Admin -> FE : Chỉnh sửa người dùng
activate FE

FE -> API : POST /admin/update-user\n{ userId, name, role }
activate API

API -> DB : UPDATE auth_users\nSET name = ?, role = ?\nWHERE id = ?
activate DB
DB --> API : Đã cập nhật
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Đã cập nhật người dùng"
deactivate FE

== Bước 3: Xóa người dùng (tùy chọn) ==

Admin -> FE : Xóa người dùng
activate FE

FE -> API : POST /admin/remove-user\n{ userId }
activate API

API -> DB : DELETE FROM auth_users\nWHERE id = ?
activate DB
DB --> API : Đã xóa
deactivate DB

API -> DB : DELETE FROM auth_sessions\nWHERE user_id = ?
activate DB
DB --> API : Đã thu hồi phiên làm việc
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Đã xóa người dùng"
deactivate FE

@enduml
