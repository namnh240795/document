@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Xác minh Token Lời mời
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Xác minh Token Lời mời

actor "Invitee" as Inv
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Nhấp liên kết lời mời ==

Inv -> FE : Nhấp liên kết trong email\n(chứa raw token trong URL)
activate FE

== Bước 2: Xác minh token (công khai, không cần xác thực) ==

FE -> API : GET /organization/verify-invitation\n?token={raw_token}
activate API

== Bước 3: Hash token ==

API -> API : SHA-256 hash\n(đồng nhất với hash đã lưu)

== Bước 4: Tra cứu lời mời ==

API -> DB : SELECT * FROM auth_invitations\nWHERE token_hash = ?
activate DB
DB --> API : Bản ghi lời mời
deactivate DB

== Bước 5: Kiểm tra ==

API -> API : Kiểm tra trạng thái + thời hạn

alt Token không tìm thấy
  API --> FE : 404 "Token lời mời không hợp lệ"
else Đang chờ + chưa hết hạn
  API --> FE : 200 { valid: true, invitation }
else Đang chờ + đã hết hạn
  API -> DB : UPDATE auth_invitations\nSET status = 'expired'\nWHERE id = ?
  activate DB
  DB --> API : Đã cập nhật
  deactivate DB
  API --> FE : 200 { valid: false, reason: "expired" }
else Đã chấp nhận
  API --> FE : 200 { valid: false, reason: "accepted" }
else Đã thu hồi
  API --> FE : 200 { valid: false, reason: "revoked" }
end

deactivate API

== Bước 6: Hiển thị kết quả ==

alt Hợp lệ
  FE --> Inv : Hiển thị chi tiết lời mời\n+ nút Chấp nhận/Từ chối
else Không hợp lệ
  FE --> Inv : Hiển thị thông báo lỗi
end

deactivate FE

@enduml
