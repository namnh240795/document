@startuml
' ============================================================
' Sequence Diagram - User Ban & Impersonation Flow
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sequence Diagram: User Ban & Impersonation Flow

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Step 1: Ban User ==

Admin -> FE : Select user to ban
activate FE

FE -> API : POST /admin/ban-user\n{ userId, banReason, expiresIn }
activate API

API -> DB : UPDATE auth_users\nSET banned = true, ban_reason = ?,\nban_expires = ?\nWHERE id = ?
activate DB
DB --> API : Updated
deactivate DB

API -> DB : DELETE FROM auth_sessions\nWHERE user_id = ?
activate DB
DB --> API : Sessions revoked
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "User banned"
deactivate FE

== Step 2: Impersonate User ==

Admin -> FE : Select user to impersonate
activate FE

FE -> API : POST /admin/impersonate-user\n{ userId }
activate API

API -> DB : INSERT INTO auth_sessions\n(user_id, impersonated_by)
activate DB
DB --> API : Session created
deactivate DB

API --> FE : 200 { token, impersonated: true }
deactivate API

FE --> Admin : Redirected as target user
deactivate FE

== Step 3: Stop Impersonation ==

Admin -> FE : Click "Stop impersonating"
activate FE

FE -> API : POST /admin/stop-impersonating
activate API

API -> DB : DELETE FROM auth_sessions\nWHERE impersonated_by = ?
activate DB
DB --> API : Session deleted
deactivate DB

API --> FE : 200 { token, impersonated: false }
deactivate API

FE --> Admin : Back to admin session
deactivate FE

@enduml
