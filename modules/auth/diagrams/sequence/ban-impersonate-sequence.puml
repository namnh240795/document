@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Khóa tài khoản & Đăng nhập giả danh
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Khóa tài khoản & Đăng nhập giả danh

skinparam sequenceArrowThickness 1
skinparam sequenceParticipantPadding 5
skinparam sequenceLifeLineBorderColor #333
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Khóa tài khoản ==

Admin -> FE : Chọn người dùng cần khóa
activate FE

FE -> API : POST /admin/ban-user\n{ userId, banReason, expiresIn }
activate API

API -> DB : UPDATE auth_users\nSET banned = true, ban_reason = ?,\nban_expires = ?\nWHERE id = ?
activate DB
DB --> API : Đã cập nhật
deactivate DB

API -> DB : DELETE FROM auth_sessions\nWHERE user_id = ?
activate DB
DB --> API : Đã thu hồi phiên làm việc
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Đã khóa tài khoản"
deactivate FE

== Bước 2: Đăng nhập giả danh ==

Admin -> FE : Chọn người dùng để đăng nhập giả danh
activate FE

FE -> API : POST /admin/impersonate-user\n{ userId }
activate API

API -> DB : INSERT INTO auth_sessions\n(user_id, impersonated_by)
activate DB
DB --> API : Đã tạo phiên làm việc
deactivate DB

API --> FE : 200 { token, impersonated: true }
deactivate API

FE --> Admin : Đã chuyển hướng với tư cách người dùng mục tiêu
deactivate FE

== Bước 3: Dừng đăng nhập giả danh ==

Admin -> FE : Nhấp "Dừng đăng nhập giả danh"
activate FE

FE -> API : POST /admin/stop-impersonating
activate API

API -> DB : DELETE FROM auth_sessions\nWHERE impersonated_by = ?
activate DB
DB --> API : Đã xóa phiên làm việc
deactivate DB

API --> FE : 200 { token, impersonated: false }
deactivate API

FE --> Admin : Quay lại phiên quản trị
deactivate FE

@enduml
