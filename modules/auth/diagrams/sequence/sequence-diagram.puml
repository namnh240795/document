@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Xác minh Tài khoản
' RabbitMQ + Redis Idempotency + SMS DB
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Xác minh Tài khoản (Idempotent + Bất đồng bộ)

actor User
participant "Frontend" as FE
participant "NestJS API" as API
database "Redis\n(Idempotency)" as Redis
database "PostgreSQL\n(auth_db)" as authDB
queue "RabbitMQ" as MQ
participant "Verification\nWorker" as Worker
participant "SMS Provider\n(Twilio)" as SMS
database "PostgreSQL\n(sms_db)" as smsDB

== Bước 1: Yêu cầu xác minh ==

User -> FE : Nhấp "Xác minh Tài khoản"
activate FE

FE -> API : POST /auth/send-verification\n{ channel: "sms" }
activate API

== Bước 2: Kiểm tra idempotency ==

API -> Redis : GET idempotency:{user_id}:sms
activate Redis

alt Key tồn tại (đã gửi trong vòng 5 phút)
  Redis --> API : Tìm thấy key
  API --> FE : 200 { message: "Đã gửi xác minh trước đó" }
  FE --> User : Hiển thị thông báo "Đã gửi trước đó"
  deactivate FE
else Key không tìm thấy
  Redis --> API : null
  deactivate Redis

  == Bước 3: Đặt idempotency key ==

  API -> Redis : SET idempotency:{user_id}:sms\nEX 300 (5 phút TTL)
  activate Redis
  Redis --> API : OK
  deactivate Redis

  == Bước 4: Lưu token xác minh ==

  API -> authDB : INSERT INTO auth_verification\n(identifier, value, expires_at)
  activate authDB
  authDB --> API : Đã tạo bản ghi xác minh
  deactivate authDB

  == Bước 5: Gửi sự kiện đến RabbitMQ ==

  API -> MQ : PUBLISH verification.sms\n{ userId, phone, otp, verificationId }
  activate MQ
  MQ --> API : Đã xếp hàng tin nhắn
  deactivate MQ

  API --> FE : 200 { message: "Đã gửi xác minh" }
  deactivate API

  FE --> User : Hiển thị thông báo "Đã gửi xác minh"
  deactivate FE

  == Bước 6: Worker xử lý sự kiện ==

  MQ -> Worker : CONSUME verification.sms
  activate Worker

  Worker -> SMS : Gửi OTP qua số điện thoại\n(Twilio API)
  activate SMS
  SMS --> Worker : { sid: "SM123", status: "queued" }
  deactivate SMS

  == Bước 7: Ghi nhật ký gửi SMS ==

  Worker -> smsDB : INSERT INTO sms_logs\n(user_id, phone, status, provider_message_id)
  activate smsDB
  smsDB --> Worker : Đã tạo nhật ký SMS
  deactivate smsDB

  == Bước 8: Cập nhật trạng thái xác minh ==

  Worker -> authDB : UPDATE auth_verification\nSET status = 'sent'
  activate authDB
  authDB --> Worker : Đã cập nhật
  deactivate authDB

  deactivate Worker

end

@enduml
