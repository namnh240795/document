@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Xác thực xã hội
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Xác thực xã hội

skinparam sequenceArrowThickness 1
skinparam sequenceParticipantPadding 5
skinparam sequenceLifeLineBorderColor #333
skinparam defaultFontSize 10
skinparam nodesep 15
skinparam ranksep 15

actor User
participant "Frontend" as FE
participant "Auth API" as API
participant "OAuth Provider\n(Google/GitHub)" as OAuth
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Bắt đầu đăng nhập xã hội ==

User -> FE : Nhấp "Đăng nhập bằng Google"
activate FE

FE -> API : POST /sign-in/social\n{ provider: "google", callbackURL }
activate API

API --> FE : 200 { url: "https://accounts.google.com/...", redirect: true }
deactivate API

FE -> OAuth : Chuyển hướng đến nhà cung cấp OAuth
activate OAuth

== Bước 2: Người dùng xác thực ==

User -> OAuth : Đăng nhập + cấp quyền
OAuth --> FE : Chuyển hướng với mã xác thực
deactivate OAuth

== Bước 3: Đổi code lấy token ==

FE -> API : POST /callback/google\n{ code, state }
activate API

API -> OAuth : Đổi code lấy token
activate OAuth
OAuth --> API : Access token + thông tin người dùng
deactivate OAuth

== Bước 4: Tạo/liên kết tài khoản ==

API -> DB : SELECT * FROM auth_accounts\nWHERE provider = ? AND provider_id = ?
activate DB
DB --> API : Tài khoản hiện có (nếu có)
deactivate DB

alt Không tìm thấy tài khoản
  API -> DB : INSERT INTO auth_users (name, email)
  activate DB
  DB --> API : Đã tạo người dùng
  deactivate DB

  API -> DB : INSERT INTO auth_accounts\n(user_id, provider, provider_id)
  activate DB
  DB --> API : Đã liên kết tài khoản
  deactivate DB
end

== Bước 5: Cấp token ==

API -> DB : INSERT INTO auth_sessions (user_id, token)
activate DB
DB --> API : Đã tạo phiên làm việc
deactivate DB

API --> FE : 200 { token, user }
deactivate API

FE --> User : Chuyển hướng đến trang tổng quan
deactivate FE

@enduml
