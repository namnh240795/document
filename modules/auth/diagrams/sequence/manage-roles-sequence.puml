@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Quản lý Vai trò
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Quản lý Vai trò

actor Admin
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Liệt kê vai trò ==

Admin -> FE : Điều hướng đến quản lý vai trò
activate FE

FE -> API : GET /organization/list-roles\n?organizationId=org-123
activate API

API -> DB : SELECT * FROM auth_organization_roles\nWHERE organization_id = ?
activate DB
DB --> API : Danh sách vai trò
deactivate DB

API --> FE : 200 { roles: [...] }
deactivate API

FE --> Admin : Hiển thị danh sách vai trò
deactivate FE

== Bước 2: Tạo vai trò ==

Admin -> FE : Tạo vai trò mới
activate FE

FE -> API : POST /organization/create-role\n{ organizationId, role, description, permission }
activate API

API -> DB : INSERT INTO auth_organization_roles\n(organization_id, role, description, permission)
activate DB
DB --> API : Đã tạo vai trò
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Đã tạo vai trò"
deactivate FE

== Bước 3: Gán vai trò ==

Admin -> FE : Gán vai trò cho thành viên
activate FE

FE -> API : POST /organization/update-member-role\n{ organizationId, userId, role }
activate API

API -> DB : UPDATE auth_members\nSET role = ?\nWHERE organization_id = ? AND user_id = ?
activate DB
DB --> API : Đã cập nhật
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> Admin : "Đã gán vai trò"
deactivate FE

@enduml
