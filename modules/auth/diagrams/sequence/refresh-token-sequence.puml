@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Làm mới Token
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Làm mới Token

actor User
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Token hết hạn ==

User -> FE : Access token đã hết hạn
activate FE

== Bước 2: Yêu cầu làm mới ==

FE -> API : POST /auth/refresh\n{ refreshToken }
activate API

== Bước 3: Kiểm tra refresh token ==

API -> DB : SELECT * FROM auth_sessions\nWHERE refresh_token = ? AND expires_at > NOW()
activate DB
DB --> API : Kết quả phiên làm việc
deactivate DB

alt Phiên làm việc không tìm thấy hoặc đã hết hạn
  API --> FE : 401 TOKEN_EXPIRED
  FE --> User : Phải đăng nhập lại
end

== Bước 4: Tạo access token mới ==

API -> API : Tạo JWT access token mới

== Bước 5: Trả về token mới ==

API --> FE : 200 { token: "new-jwt...", session }
deactivate API

FE --> User : Access token đã được cập nhật
deactivate FE

@enduml
