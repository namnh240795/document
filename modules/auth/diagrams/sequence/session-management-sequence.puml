@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Quản lý Phiên làm việc
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Quản lý Phiên làm việc

actor User
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Liệt kê phiên làm việc ==

User -> FE : Điều hướng đến cài đặt phiên làm việc
activate FE

FE -> API : GET /list-sessions
activate API

API -> DB : SELECT * FROM auth_sessions\nWHERE user_id = ?\nORDER BY created_at DESC
activate DB
DB --> API : Danh sách phiên làm việc
deactivate DB

API --> FE : 200 { sessions: [...] }
deactivate API

FE --> User : Hiển thị phiên làm việc\n(thiết bị, IP, hoạt động lần cuối)
deactivate FE

== Bước 2: Thu hồi phiên làm việc ==

User -> FE : Chọn phiên làm việc cần thu hồi
activate FE

FE -> API : POST /revoke-session\n{ sessionId }
activate API

API -> DB : DELETE FROM auth_sessions\nWHERE id = ? AND user_id = ?
activate DB
DB --> API : Đã xóa
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> User : "Đã thu hồi phiên làm việc"
deactivate FE

== Bước 3: Thu hồi tất cả phiên khác ==

User -> FE : Nhấp "Thu hồi tất cả phiên khác"
activate FE

FE -> API : POST /revoke-other-sessions
activate API

API -> DB : DELETE FROM auth_sessions\nWHERE user_id = ?\nAND id != current_session_id
activate DB
DB --> API : Đã xóa
deactivate DB

API --> FE : 200 { success: true }
deactivate API

FE --> User : "Đã thu hồi tất cả phiên khác"
deactivate FE

@enduml
