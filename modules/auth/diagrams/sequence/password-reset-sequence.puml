@startuml
' ============================================================
' Sequence Diagram - Password Reset Flow
' Email/Phone OTP + Password Update
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sequence Diagram: Password Reset Flow

actor User
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB
database "Redis\n(Idempotency)" as Redis
queue "RabbitMQ" as MQ
participant "Notification\nWorker" as Worker
participant "Email/SMS\nService" as Notif

== Step 1: Request Password Reset ==

User -> FE : Enter email or phone
activate FE

FE -> API : POST /auth/forgot-password\n{ identifier: "user@example.com" }
activate API

== Step 2: Idempotency Check ==

API -> Redis : GET idempotency:reset:{identifier}
activate Redis
Redis --> API : Result
deactivate Redis

== Step 3: Find User ==

API -> DB : SELECT * FROM auth_users\nWHERE email = ? OR phone = ?
activate DB
DB --> API : User record (or null)
deactivate DB

== Step 4: Set Idempotency Key ==

API -> Redis : SET idempotency:reset:{identifier}\nEX 300 (5 min TTL)
activate Redis
Redis --> API : OK
deactivate Redis

== Step 5: Generate Reset Token ==

API -> API : Generate secure reset token\n(64-char random string)

API -> DB : INSERT INTO auth_verification\n(user_id, code, type: 'password_reset',\n expires_at: NOW() + 1 hour)
activate DB
DB --> API : Verification record
deactivate DB

== Step 6: Send Reset Link/OTP ==

API -> MQ : PUBLISH password.reset\n{ userId, email, phone, resetToken }
activate MQ
MQ --> API : Queued
deactivate MQ

API --> FE : 200 "If account exists, reset link sent"
deactivate API

FE --> User : Show "Check your email/phone"
deactivate FE

== Step 7: Async - Send Notification ==

MQ -> Worker : CONSUME password.reset
activate Worker

Worker -> Notif : Send reset link to email\nor OTP to phone
activate Notif
Notif --> Worker : Sent
deactivate Notif

Worker -> MQ : ACK
deactivate Worker

== Step 8: User Resets Password ==

User -> FE : Click reset link / enter OTP
activate FE

FE -> API : POST /auth/reset-password\n{ token, newPassword }
activate API

API -> DB : SELECT * FROM auth_verification\nWHERE code = ? AND type = 'password_reset'\nAND used = false AND expires_at > NOW()
activate DB
DB --> API : Verification record (or null)
deactivate DB

== Step 9: Update Password ==

API -> API : bcrypt.hash(newPassword, 12)

API -> DB : UPDATE auth_users\nSET password_hash = ?, updated_at = NOW()\nWHERE id = ?
activate DB
DB --> API : Updated
deactivate DB

API -> DB : UPDATE auth_verification\nSET used = true\nWHERE id = ?
activate DB
DB --> API : Updated
deactivate DB

== Step 10: Invalidate Sessions ==

API -> DB : DELETE FROM auth_sessions\nWHERE user_id = ?
activate DB
DB --> API : Sessions deleted
deactivate DB

API --> FE : 200 "Password updated successfully"
deactivate API

FE --> User : Show "Password updated"\n+ "Please login with new password"
deactivate FE

@enduml
