@startuml
' ============================================================
' Sequence Diagram - Change Password Flow
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sequence Diagram: Change Password Flow

actor User
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Step 1: Change Password Request ==

User -> FE : Enter current + new password
activate FE

FE -> API : POST /auth/change-password\n{ currentPassword, newPassword }
activate API

== Step 2: Verify Current Password ==

API -> DB : SELECT password_hash FROM auth_users\nWHERE id = ?
activate DB
DB --> API : Password hash
deactivate DB

API -> API : bcrypt.compare(currentPassword, hash)

alt Current password incorrect
  API --> FE : 401 INVALID_CREDENTIALS
  FE --> User : Show "Incorrect password"
end

== Step 3: Hash New Password ==

API -> API : bcrypt.hash(newPassword, 12)

== Step 4: Update Password ==

API -> DB : UPDATE auth_users\nSET password_hash = ?\nWHERE id = ?
activate DB
DB --> API : Updated
deactivate DB

== Step 5: Response ==

API --> FE : 200 { success: true }
deactivate API

FE --> User : "Password changed successfully"
deactivate FE

@enduml
