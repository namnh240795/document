@startuml
' ============================================================
' Sơ đồ Tuần tự - Luồng Đổi mật khẩu
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sơ đồ Tuần tự: Luồng Đổi mật khẩu

actor User
participant "Frontend" as FE
participant "Auth API" as API
database "PostgreSQL\n(auth_db)" as DB

== Bước 1: Yêu cầu đổi mật khẩu ==

User -> FE : Nhập mật khẩu hiện tại + mật khẩu mới
activate FE

FE -> API : POST /auth/change-password\n{ currentPassword, newPassword }
activate API

== Bước 2: Xác minh mật khẩu hiện tại ==

API -> DB : SELECT password_hash FROM auth_users\nWHERE id = ?
activate DB
DB --> API : Hash mật khẩu
deactivate DB

API -> API : bcrypt.compare(currentPassword, hash)

alt Mật khẩu hiện tại không đúng
  API --> FE : 401 INVALID_CREDENTIALS
  FE --> User : Hiển thị "Mật khẩu không đúng"
end

== Bước 3: Mã hóa mật khẩu mới ==

API -> API : bcrypt.hash(newPassword, 12)

== Bước 4: Cập nhật mật khẩu ==

API -> DB : UPDATE auth_users\nSET password_hash = ?\nWHERE id = ?
activate DB
DB --> API : Đã cập nhật
deactivate DB

== Bước 5: Phản hồi ==

API --> FE : 200 { success: true }
deactivate API

FE --> User : "Đổi mật khẩu thành công"
deactivate FE

@enduml
