@startuml
title Hệ thống Xác thực — Sơ đồ Use Case

skinparam defaultTextAlignment center
skinparam usecaseFontSize 10
skinparam actorFontSize 11
skinparam shadowing false
skinparam nodesep 20
skinparam ranksep 20

actor "User" as user
actor "Admin" as admin
actor "System" as system

rectangle "Module AUTH" {
  usecase "Đăng ký" as UC01
  usecase "Đăng nhập" as UC02
  usecase "Đăng xuất" as UC03
  usecase "Làm mới Token" as UC04
  usecase "Đặt lại MK\n(Email)" as UC05
  usecase "Đặt lại MK\n(OTP)" as UC06
  usecase "Thay đổi MK" as UC07
  usecase "Xác minh Email" as UC08
  usecase "Xác minh SĐT" as UC09
  usecase "Quản lý\nNgười dùng" as UC10
  usecase "Quản lý\nVai trò" as UC11
}

user --> UC01
user --> UC02
user --> UC03
user --> UC05
user --> UC06
user --> UC07

admin --> UC10
admin --> UC11

system --> UC08
system --> UC09

UC02 ..> UC04 : <<include>>
UC05 ..> UC07 : <<extend>>
UC06 ..> UC07 : <<extend>>

@enduml
