@startuml
' ============================================================
' Sơ đồ Thành phần - Module AUTH
' ============================================================

!pragma layout smetana
top to bottom direction

skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam nodesep 40
skinparam ranksep 50

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #666666
  FontSize 11
  FontColor #000000
  RoundCorner 6
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
  FontColor #000000
}

skinparam queue {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
  FontColor #000000
}

skinparam arrow {
  Color #000000
  Thickness 2
}

skinparam linetype polyline

title Module AUTH - Sơ đồ Thành phần

skinparam componentFontSize 10
skinparam nodesep 15
skinparam ranksep 15

' --- Khách hàng ---
component "Ứng dụng Web" as web
component "Ứng dụng Di động" as mobile

' --- Lớp API ---
component "Auth Controller" as authCtrl
component "Users Controller" as usersCtrl
component "Roles Controller" as rolesCtrl

' --- Lớp Service ---
component "Auth Service" as authSvc #FFD54F
component "Users Service" as usersSvc
component "Roles Service" as rolesSvc

' --- Bảo mật ---
component "JWT Guard" as jwtGuard
component "RBAC Guard" as rbacGuard

' --- Hạ tầng ---
database "auth_db\n(PostgreSQL)" as db
queue "RabbitMQ" as mq #FFD54F
database "Redis" as redis

' --- Khách hàng -> API ---
web -down-> authCtrl
mobile -down-> authCtrl
web -down-> usersCtrl

' --- API -> Bảo mật ---
authCtrl -down-> jwtGuard
usersCtrl -down-> jwtGuard
rolesCtrl -down-> jwtGuard

' --- Bảo mật -> Service ---
jwtGuard -down-> authSvc
rbacGuard -down-> rolesSvc

' --- API -> Service ---
authCtrl -down-> authSvc
usersCtrl -down-> usersSvc
rolesCtrl -down-> rolesSvc

' --- Service -> Hạ tầng ---
authSvc -down-> db
usersSvc -down-> db
rolesSvc -down-> db

authSvc -down-> mq
authSvc -down-> redis

' --- Căn hàng: Lớp API ---
authCtrl -[hidden]right-> usersCtrl
usersCtrl -[hidden]right-> rolesCtrl

' --- Căn hàng: Lớp Service ---
authSvc -[hidden]right-> usersSvc
usersSvc -[hidden]right-> rolesSvc

' --- Căn hàng: Hạ tầng ---
db -[hidden]right-> mq
mq -[hidden]right-> redis

' --- Khoảng cách cuối ---
redis -[hidden]down-> redis

@enduml
