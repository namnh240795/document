@startuml
' ============================================================
' Component Diagram - Authentication System
' Updated: RabbitMQ, Redis, Verification Worker
' ============================================================

skinparam component {
  BackgroundColor #F8F8F8
  BorderColor #333333
  ArrowColor #333333
  InterfaceBackgroundColor #FFFFFF
  InterfaceBorderColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Authentication System - Component Diagram

' --- External Users ---
actor "User" as user
actor "Admin" as admin

' --- Client Layer ---
package "Client Layer" {
  [Web Application\n(React/Vue/Next.js)] as web
  [Mobile App\n(React Native/Flutter)] as mobile
}

' --- API Layer ---
package "NestJS Application" {
  [Auth Controller\n(/auth/*)] as authCtrl
  [User Controller\n(/users/*)] as userCtrl
  [Role Controller\n(/roles/*)] as roleCtrl

  [Auth Service\n(Business Logic)] as authSvc
  [User Service\n(User CRUD)] as userSvc
  [Verification Service\n(Idempotency Check)] as verifySvc

  [Better Auth\n(Core Library)] as betterAuth
  [Passport.js\n(Guards)] as passport

  [Drizzle ORM\n(Database Layer)] as drizzle

  [Redis Client\n(ioredis)] as redisClient

  database "PostgreSQL\n(auth_db)" as db
}

' --- Message Queue ---
package "Event-Driven Layer" {
  queue "RabbitMQ\n(AMQP)" as mq
  [Verification Worker\n(Email Consumer)] as emailWorker
  [Verification Worker\n(SMS Consumer)] as smsWorker
}

' --- Data Layer ---
package "Data Layer" {
  database "Redis\n(Idempotency + Cache)" as redis
  database "PostgreSQL\n(sms_db)" as smsDB
}

' --- External Services ---
package "External Services" {
  [Email Provider\n(SendGrid / Resend)] as emailProvider
  [SMS Provider\n(Twilio)] as smsProvider
}

' --- Relationships ---
user --> web
admin --> web
user --> mobile

web --> authCtrl
web --> userCtrl
mobile --> authCtrl
mobile --> userCtrl

authCtrl --> authSvc
userCtrl --> userSvc
roleCtrl --> userSvc

authSvc --> betterAuth
authSvc --> verifySvc
userSvc --> drizzle

verifySvc --> redisClient : check idempotency key
verifySvc --> mq : publish event

betterAuth --> drizzle
drizzle --> db

redisClient --> redis : TCP 6379

mq --> emailWorker : consume
mq --> smsWorker : consume

emailWorker --> emailProvider : HTTPS
emailWorker --> db : log to auth_verification

smsWorker --> smsProvider : HTTPS
smsWorker --> smsDB : TCP 5432\nlog to sms_logs

note bottom of mq
  Queues:
  - verification.email
  - verification.sms
  - DLQ (dead letter)
end note

note bottom of redis
  Redis Keys:
  - idempotency:{user_id}:{channel}
  - resend_verify:{user_id}:{channel}
  - session:{token}
end note

@enduml
