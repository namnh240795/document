@startuml
' ============================================================
' Sequence Diagram - Account Verification Flow
' RabbitMQ + Redis Idempotency + SMS DB
' ============================================================

skinparam sequence {
  ArrowColor #333333
  ActorBorderColor #333333
  LifeLineBorderColor #333333
  ParticipantBackgroundColor #F8F8F8
  ParticipantBorderColor #333333
}

title Sequence Diagram: Account Verification (Idempotent + Async)

actor User
participant "Frontend" as FE
participant "NestJS API" as API
database "Redis\n(Idempotency)" as Redis
database "PostgreSQL\n(auth_db)" as authDB
queue "RabbitMQ" as MQ
participant "Verification\nWorker" as Worker
participant "SMS Provider\n(Twilio)" as SMS
database "PostgreSQL\n(sms_db)" as smsDB

== Step 1: Request Verification ==

User -> FE : Click "Verify Account"
activate FE

FE -> API : POST /auth/send-verification\n{ channel: "sms" }
activate API

== Step 2: Idempotency Check ==

API -> Redis : GET idempotency:{user_id}:sms
activate Redis

alt Key exists (already sent within 5 min)
  Redis --> API : key found
  API --> FE : 200 { message: "Verification already sent" }
  FE --> User : Show "Already sent" message
  deactivate FE
else Key not found
  Redis --> API : null
  deactivate Redis

  == Step 3: Set Idempotency Key ==

  API -> Redis : SET idempotency:{user_id}:sms\nEX 300 (5 min TTL)
  activate Redis
  Redis --> API : OK
  deactivate Redis

  == Step 4: Store Verification Token ==

  API -> authDB : INSERT INTO auth_verification\n(identifier, value, expires_at)
  activate authDB
  authDB --> API : Verification record created
  deactivate authDB

  == Step 5: Publish Event to RabbitMQ ==

  API -> MQ : PUBLISH verification.sms\n{ userId, phone, otp, verificationId }
  activate MQ
  MQ --> API : Message queued
  deactivate MQ

  API --> FE : 200 { message: "Verification sent" }
  deactivate API

  FE --> User : Show "Verification sent" message
  deactivate FE

  == Step 6: Worker Consumes Event ==

  MQ -> Worker : CONSUME verification.sms
  activate Worker

  Worker -> SMS : Send OTP to phone\n(Twilio API)
  activate SMS
  SMS --> Worker : { sid: "SM123", status: "queued" }
  deactivate SMS

  == Step 7: Log SMS Delivery ==

  Worker -> smsDB : INSERT INTO sms_logs\n(user_id, phone, status, provider_message_id)
  activate smsDB
  smsDB --> Worker : SMS log created
  deactivate smsDB

  == Step 8: Update Verification Status ==

  Worker -> authDB : UPDATE auth_verification\nSET status = 'sent'
  activate authDB
  authDB --> Worker : Updated
  deactivate authDB

  deactivate Worker

end

@enduml
