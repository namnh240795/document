@startuml
' ============================================================
' Architecture Overview - Authentication System (C4 Level 1)
' Updated: RabbitMQ, Redis, SMS DB
' ============================================================

skinparam actor {
  BackgroundColor #F8F8F8
  BorderColor #333333
}
skinparam component {
  BackgroundColor #F8F8F8
  BorderColor #333333
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #666666
}
skinparam cloud {
  BackgroundColor #E8E8FD
  BorderColor #333333
}

title System Context Diagram (C4 Level 1) - Authentication System

' --- People ---
actor "User" as user
actor "Admin" as admin

' --- Our System ---
cloud "Authentication System" as system {
  package "Client Applications" {
    [Web Application] as web
    [Mobile Application] as mobile
  }

  package "Backend (NestJS)" {
    [Auth API] as api
    [Better Auth] as ba
    [Drizzle ORM] as orm
    [Verification Worker] as worker
  }

  package "Data Layer" {
    database "PostgreSQL\n(auth_db)" as authDB
    database "PostgreSQL\n(sms_db)" as smsDB
    database "Redis\n(Idempotency + Cache)" as redis
    queue "RabbitMQ\n(Event Queue)" as mq
  }
}

' --- External Systems ---
cloud "Email Provider\n(SendGrid / Resend)" as email
cloud "SMS Provider\n(Twilio)" as sms

' --- Relationships ---
user --> web
user --> mobile
admin --> web

web --> api
mobile --> api

api --> ba
ba --> orm
orm --> authDB

api --> redis : idempotency check\n+ rate limiting

api --> mq : publish\nverification event

mq --> worker : consume events

worker --> email : send verification email
worker --> sms : send OTP SMS
worker --> smsDB : log SMS delivery

orm --> smsDB : SMS audit logs

ba ..> email : verification emails
ba ..> sms : OTP codes

note bottom of system
  Authentication System
  - NestJS backend
  - Better Auth for auth logic
  - Drizzle ORM for PostgreSQL
  - RabbitMQ for async verification
  - Redis for idempotency + cache
  - Dedicated SMS database
end note

@enduml
